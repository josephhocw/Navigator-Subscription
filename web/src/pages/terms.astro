<style>
  .last-updated { color: var(--muted); font-size: 0.95rem; }

  /* Contents — lets a subscriber jump straight to the clause they need
     (the page runs ~13,000px on a phone otherwise) */
  .prose .toc {
    background: var(--surface); border: 1px solid var(--line);
    border-radius: 12px; padding: 1.2rem 1.4rem; margin: 2rem 0;
  }
  .prose .toc > strong { display: block; color: var(--ink); margin-bottom: 0.6rem; font-size: 1.05rem; }
  .prose .toc ol {
    margin: 0; padding-left: 1.4rem;
    columns: 2; column-gap: 2.5rem;
  }
  .prose .toc li { margin: 0; break-inside: avoid; }
  .prose .toc a { color: var(--cyan); display: inline-block; padding: 0.4rem 0; }
  .prose .toc a:hover { text-decoration: underline; }
  @media (max-width: 640px) {
    .prose .toc ol { columns: 1; }
  }

  /* Risk / acknowledgment callouts — amber accent on the dark theme */
  .prose .tw {
    background: rgba(245, 158, 11, 0.08);
    border: 1px solid rgba(245, 158, 11, 0.28);
    border-left: 3px solid #f59e0b;
    border-radius: 12px;
    padding: 1.2rem 1.4rem;
    margin: 2rem 0;
  }
  .prose .tw > strong { display: block; color: #fbbf24; margin-bottom: 0.5rem; font-size: 1.05rem; }
  .prose .tw p { margin: 0; color: var(--text); }
  .prose .tw ul { margin: 0.8rem 0 0 1.3rem; }
  .prose .tw li { color: var(--text); }

  /* Contact box — cyan accent */
  .prose .tc {
    background: rgba(56, 189, 248, 0.06);
    border: 1px solid rgba(56, 189, 248, 0.22);
    border-radius: 12px;
    padding: 1.4rem;
    margin: 1.6rem 0;
    text-align: center;
  }
  .prose .tc p { margin: 0.3rem 0; }
</style>
