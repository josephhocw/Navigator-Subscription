---
import Base from '../layouts/Base.astro';

const PEPPERSTONE_LINK = 'https://trk.pepperstonepartners.com/aff_c?offer_id=439&aff_id=33751';
const ERIK_WHATSAPP = 'https://wa.me/61431750066';
---
<Base
  title="Free TradingView — RHO Navigator"
  description="Open a Pepperstone account through us and get a paid TradingView plan free — worth up to $99 SGD a month. Why we use Pepperstone, and the honest answers on safety."
>
  <section class="page-hero flush">
    <div class="container">
      <span class="eyebrow">Your TradingView, free</span>
      <h1>Get your TradingView plan <span class="hl">free</span></h1>
      <p>The Navigator runs on TradingView. Open an account through us and the paid plan is free.</p>
    </div>
  </section>

  <!-- ===== The offer: stacking note, three steps, then the plans table ===== -->
  <section class="section offer-section" id="the-offer">
    <div class="container">
      <p class="offer-callout">
        <svg viewBox="0 0 24 24"><path d="m12 2 9 5-9 5-9-5 9-5Z"/><path d="m3 12 9 5 9-5"/><path d="m3 17 9 5 9-5"/></svg>
        <span><b>Already paying for TradingView?</b> It's not wasted — the free plan stacks three months on top of your current expiry.</span>
      </p>

      <ol class="how-list">
        <li>
          <span class="how-n">1</span>
          <div class="how-txt">
            <h4>Open your account</h4>
            <p>Create a Pepperstone account through our referral link, then pick the TradingView plan you want to claim.</p>
          </div>
        </li>
        <li>
          <span class="how-n">2</span>
          <div class="how-txt">
            <h4>Fund it and place one trade</h4>
            <p>Add the deposit your plan needs and make a single trade. Pepperstone then emails you the coupon link for your free TradingView plan.</p>
          </div>
        </li>
        <li>
          <span class="how-n">3</span>
          <div class="how-txt">
            <h4>Keep it free</h4>
            <p>Trade your plan's lot target every three months and Pepperstone emails you fresh codes to renew at no cost.</p>
          </div>
        </li>
      </ol>

      <h2 class="offer-plans-title">Pick the plan you want <span class="hl">free</span></h2>
      <div class="ctas-center">
        <a href={PEPPERSTONE_LINK} target="_blank" rel="noopener" class="btn btn-primary btn-sm">Open a Pepperstone account</a>
        <a href="/guides/open-pepperstone-free-tradingview" class="btn btn-ghost btn-sm">Follow the step-by-step guide</a>
      </div>
      <div class="tv-table-wrap">
        <table class="tv-table">
          <thead>
            <tr>
              <th>Plan</th>
              <th>Normally</th>
              <th>To claim</th>
              <th>To renew free</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td data-label="Plan"><span class="tvt-plan">Essential</span></td>
              <td data-label="Normally"><b>$25</b> SGD / month</td>
              <td data-label="To claim">$400 SGD deposit + one trade</td>
              <td data-label="To renew free">12 lots every 3 months</td>
            </tr>
            <tr>
              <td data-label="Plan"><span class="tvt-plan">Plus</span></td>
              <td data-label="Normally"><b>$50</b> SGD / month</td>
              <td data-label="To claim">$1,300 SGD deposit + one trade</td>
              <td data-label="To renew free">15 lots every 3 months</td>
            </tr>
            <tr class="tvt-featured">
              <td data-label="Plan"><span class="tvt-plan">Premium</span><span class="tvt-badge">Most worth</span></td>
              <td data-label="Normally"><b>$99</b> SGD / month</td>
              <td data-label="To claim">$3,900 SGD deposit + one trade</td>
              <td data-label="To renew free">35 lots every 3 months</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ===== Lower Navigator price ===== -->
  <!-- The pricing modal and the pricing footnote both promise "a lower price just
       for opening an account" — this section is where that promise is delivered.
       Deliberately deposit-free copy: funding belongs to the TradingView promo above. -->
  <section class="section alt" id="lower-price">
    <div class="container split2">
      <div>
        <div class="section-head">
          <span class="eyebrow">Your Navigator price</span>
          <h2>Your Navigator gets <span class="hl">cheaper too</span></h2>
        </div>
        <p class="sub" style="color:var(--muted); max-width:48ch; margin:1rem 0 1.8rem;">Opening your Pepperstone account through our link also unlocks a lower price on every Navigator plan — $21 SGD less per quarter on single markets, $30 SGD less on combos and All Markets, for as long as you subscribe. Opening the account is the only requirement; the deposit and trade above are only for the free TradingView plan.</p>
        <a href="/?mode=pepperstone#pricing" class="btn btn-primary">Subscribe at the Pepperstone price</a>
      </div>
      <div class="offer">
        <div class="ocard">
          <div class="tvname">All Markets plan · per quarter</div>
          <div class="pricerow"><span class="was">$417</span><span class="now">$387</span></div>
          <div class="tag">With a Pepperstone account</div>
          <div class="note">Every plan drops. Pick yours on the pricing page with the toggle set to Pepperstone Price.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== How lots are counted ===== -->
  <section class="section" id="lots">
    <div class="container">
      <div class="lots">
        <h3 class="lots-title">How "lots" are counted</h3>

        <div class="lots-grid">
          <div class="lots-col">
            <div class="lots-col-label">What one lot is</div>
            <div class="lot-def">
              <span class="ld-chip">Open a trade</span>
              <svg class="ld-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"/><path d="m13 6 6 6-6 6"/></svg>
              <span class="ld-chip">Close it</span>
            </div>
            <div class="lot-result"><span class="eq">=</span><b class="num">1</b><span class="unit">lot</span></div>
            <p class="lot-cap">One full round trade — opening a position and then closing it.</p>
          </div>

          <div class="lots-col">
            <div class="lots-col-label">How each market counts toward your target</div>
            <div class="lots-eq">
              <div class="leq">
                <span class="leq-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M9.5 9.5h3.75a1.75 1.75 0 0 1 0 3.5h-2.5a1.75 1.75 0 0 0 0 3.5h4"/></svg></span>
                <span class="leq-mkt">Forex &amp; Gold</span>
                <span class="leq-r"><b class="from">1</b><span class="arr">→</span><b class="to">1</b><i>lot</i></span>
              </div>
              <div class="leq">
                <span class="leq-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><rect x="7" y="10" width="3" height="7" rx="0.6"/><rect x="12" y="6" width="3" height="11" rx="0.6"/><rect x="17" y="13" width="3" height="4" rx="0.6"/></svg></span>
                <span class="leq-mkt">Shares &amp; Indices</span>
                <span class="leq-r"><b class="from">10</b><span class="arr">→</span><b class="to">1</b><i>lot</i></span>
              </div>
              <div class="leq">
                <span class="leq-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 2 8.66 5v10L12 22 3.34 17V7z"/><path d="M9.5 9.3h3.4a1.5 1.5 0 0 1 0 3h-2.4a1.5 1.5 0 0 0 0 3h3.4"/></svg></span>
                <span class="leq-mkt">Crypto</span>
                <span class="leq-r"><b class="from">4</b><span class="arr">→</span><b class="to">1</b><i>lot</i></span>
              </div>
            </div>
          </div>
        </div>

        <p class="lots-note">Mix any markets to get there. You only count lots if you want to keep renewing for free.</p>
      </div>
    </div>
  </section>

  <!-- ===== Why Pepperstone ===== -->
  <section class="section alt" id="why-pepperstone">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Why Pepperstone</span>
        <h2>Why we trade through <span class="hl">Pepperstone</span></h2>
      </div>
      <div class="feat3">
        <div class="feat">
          <div class="ic"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="14" rx="2"/><polyline points="7 12 10 9 13 12 17 8"/></svg></div>
          <h4>Charts and trading in one place</h4>
          <p>Pepperstone connects directly to TradingView. You see the chart, you click, the trade goes in. There's no separate trading app to juggle.</p>
        </div>
        <div class="feat">
          <div class="ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M9.5 9.5h3.75a1.75 1.75 0 0 1 0 3.5h-2.5a1.75 1.75 0 0 0 0 3.5h4"/></svg></div>
          <h4>Live prices without the fees</h4>
          <p>TradingView charges a monthly fee for live data from most exchanges. A connected broker's feed is free, so you get live prices on your charts without paying per market.</p>
        </div>
        <div class="feat">
          <div class="ic"><svg viewBox="0 0 24 24"><path d="M9 12l2 2 4-5"/><circle cx="12" cy="12" r="9"/></svg></div>
          <h4>Your chart matches our signals</h4>
          <p>The Navigator works out its levels from the price feed it's given. We run everything on Pepperstone data — when you do too, your channel and our signals line up exactly.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Is it safe? ===== -->
  <section class="section" id="is-it-safe">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">The honest questions</span>
        <h2>Is my money <span class="hl">safe</span>?</h2>
        <p>Most of our clients are in Singapore, and the first question is usually the same: Pepperstone isn't MAS-regulated, so can I trust it? Fair question. Here are the facts.</p>
      </div>
      <div class="faq-list">
        <details class="faq-item">
          <summary class="faq-q">Why isn't Pepperstone regulated by MAS?<svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></summary>
          <div class="faq-a"><p>It's a choice about product range, not a rejection. MAS rules limit what retail traders in Singapore can access — foreign-exchange leverage is capped at 20:1, for instance, and the product menu is narrower. Pepperstone's international entity exists so traders get the full range, including the markets the Navigator covers. The group itself answers to seven regulators worldwide, including Australia's ASIC and the UK's FCA, two of the strictest.</p></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Is my money mixed with Pepperstone's own money?<svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></summary>
          <div class="faq-a"><p>No. Client money sits in segregated accounts at Tier-1 banks, Barclays in the UK among them. If Pepperstone ever went under, that money isn't part of the company's assets — it goes back to clients. EY audits the segregation every year, and confirmed around AU$362 million in segregated client funds for 2025.</p></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">I've heard foreign brokers can run off with your money.<svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></summary>
          <div class="faq-a"><p>It has happened, and being wary is sensible. The brokers that vanish are small, unregulated and based in one place. Pepperstone has operated since 2010, serves over 830,000 clients, handles around AU$1 trillion in trades a month, publishes audited accounts, and sponsors the Aston Martin Aramco F1 team and the ATP Tour. A company under that much scrutiny can't quietly disappear.</p></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Can I actually get my money out?<svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></summary>
          <div class="faq-a"><p>Yes — we and our clients withdraw regularly. Pepperstone supports PayNow for Singapore clients: deposits arrive instantly, withdrawals usually take an hour to a day, and there are no fees either way.</p></div>
        </details>
      </div>
    </div>
  </section>

  <!-- ===== Credibility ===== -->
  <section class="section alt" id="credibility">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Pepperstone in numbers</span>
        <h2>Too big to <span class="hl">quietly disappear</span></h2>
      </div>
      <div class="stats">
        <div class="stat"><span class="n">2010</span><span class="l">Founded in Melbourne, Australia</span></div>
        <div class="stat"><span class="n">830,000+</span><span class="l">Active clients in 150 countries</span></div>
        <div class="stat"><span class="n">AU$1T</span><span class="l">In trades handled every month</span></div>
        <div class="stat"><span class="n">7</span><span class="l">Regulators across the group, ASIC and FCA included</span></div>
      </div>
      <p class="section-note">Official partner of the Aston Martin Aramco F1 team, the ATP Tour and the Asian Football Confederation.</p>
    </div>
  </section>

  <!-- ===== Talk to Erik ===== -->
  <section class="erik-section">
    <div class="container">
      <div class="erik-card">
        <div class="erik-ic">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-8.5 8.5 8.5 8.5 0 0 1-3.8-.9L3 21l1.9-5.7a8.5 8.5 0 0 1-.9-3.8A8.4 8.4 0 0 1 12.5 3 8.4 8.4 0 0 1 21 11.5z" /></svg>
        </div>
        <div class="erik-body">
          <b>Questions before you start?</b>
          <p>Erik, our account manager at Pepperstone, looks after our clients personally. WhatsApp him any time on +61 431 750 066.</p>
        </div>
        <a href={ERIK_WHATSAPP} target="_blank" rel="noopener" class="btn btn-primary erik-btn">Message Erik on WhatsApp</a>
      </div>
    </div>
  </section>

  <!-- ===== Final CTA ===== -->
  <section class="cta-final">
    <div class="container">
      <h2>Ready to set it up?</h2>
      <p>The first setup guide walks you through opening the account, funding it and claiming your free plan.</p>
      <div class="hero-ctas">
        <a href="/guides/open-pepperstone-free-tradingview" class="btn btn-primary">Start the setup guide</a>
        <a href="/#pricing" class="btn btn-ghost">View plans</a>
      </div>
    </div>
  </section>
</Base>
