---
import Base from '../layouts/Base.astro';
import PriceToggle from '../components/PriceToggle.astro';
// The grid, modals, styles and wiring all live in PriceToggle.astro —
// the same component renders in the homepage #pricing section.
---
<Base title="Pricing — RHO Navigator" description="Pick your markets. Trade with us through Pepperstone and pay the lower price. Billed quarterly, cancel anytime.">
  <section class="section pricing-section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Pricing</span>
        <h2>Pick your markets</h2>
        <p>Trade with us through Pepperstone and you pay the lower price — and your TradingView comes free.</p>
      </div>

      <PriceToggle />

      <p class="pep-foot">The Pepperstone price needs only a Pepperstone account opened under our link. <a href="/free-tradingview">How it works →</a></p>
    </div>
  </section>
</Base>
