---
import Base from '../layouts/Base.astro';
import HeroVisual from '../components/HeroVisual.astro';
import PriceToggle from '../components/PriceToggle.astro';

// Section order follows the Navigator Preview deck's sales arc:
// hero → showcase → what you get → pricing (full grid)
// → free TradingView ("effectively free", right after the prices) → FAQ → CTA.
const TELEGRAM = 'https://t.me/Joseph_Ho';
---
<Base>
  <!-- ===== Hero ===== -->
  <header class="hero">
    <div class="hero-bg"></div>
    <div class="container">
      <div class="hero-grid">
        <div class="hero-copy">
          <span class="eyebrow fade-up" style="margin-bottom:1.4rem;"><span class="dot"></span> Built with Robin Ho · 20 years in the markets</span>
          <h1 class="fade-up" style="animation-delay:.06s;">Always a trend.<br /><span class="hl">Now you'll see it.</span></h1>
          <p class="sub fade-up" style="animation-delay:.12s;">A TradingView indicator that reads support, resistance and trend for you — and a private Telegram group that sends the buy and sell signals straight to your phone.</p>
          <div class="hero-ctas fade-up" style="animation-delay:.18s;">
            <a href="#pricing" class="btn btn-primary">View plans</a>
            <a href="#showcase" class="btn btn-ghost">See how it works</a>
          </div>
          <p class="hero-perk fade-up" style="animation-delay:.22s;"><span class="ck">✓</span> Comes with a free TradingView plan worth up to $99 SGD a month</p>
        </div>

        <!-- Compass visual — the animated product signature (HeroVisual.astro) -->
        <div class="hero-visual">
          <div class="hero-visual-scale">
            <HeroVisual />
          </div>
        </div>
      </div>
    </div>

    <!-- floating market strip -->
    <div class="market-strip">
      <div class="schip"><span class="d"></span>Hong Kong</div>
      <div class="schip"><span class="d"></span>Singapore</div>
      <div class="schip"><span class="d"></span>US</div>
      <div class="schip"><span class="d"></span>Forex · Crypto · Metals</div>
    </div>
  </header>

  <!-- ===== Showcase ===== -->
  <section class="showcase" id="showcase">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">The indicator</span>
        <h2>See it work <span class="hl">in real time</span></h2>
        <p>Support, resistance and trend — redrawn the moment price moves.</p>
      </div>

      <div class="tabs">
        <button class="tab on" data-pane="pane-live"><span class="live-dot"></span> Watch it work</button>
        <button class="tab" data-pane="pane-walk">How it works</button>
      </div>

      <div class="stage">
        <div class="glow"></div>
        <div class="glow top"></div>
        <div class="media">
          <div class="pane on" id="pane-live">
            <div class="media-bar">
              <span class="replay"><span class="rep-ic"></span>REPLAY</span>
              <span class="sym">RHO Navigator</span>
              <span class="right">historical chart, sped up</span>
            </div>
            <div class="shot">
              <!-- No autoplay/preload: the 1.1MB file must not download until the
                   demo is actually near the viewport. The IntersectionObserver
                   below calls play() as it scrolls into view, which starts the
                   fetch; the poster covers the frame until then. -->
              <video
                id="demoVideo"
                class="demo-video"
                poster="/assets/demo-poster.jpg"
                muted
                loop
                playsinline
                preload="none"
                aria-label="The RHO Navigator drawing trend channels and buy and sell signals on a replayed price chart"
              >
                <source src="/landingvideo-2.webm" type="video/webm" />
                <source src="/landingvideo-2.mp4" type="video/mp4" />
              </video>
              <div class="vc" id="videoCtrl">
                <button class="vc-btn playing" id="vcPlay" type="button" aria-label="Pause">
                  <svg class="ic-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                  <svg class="ic-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3.4v14H7zM13.6 5H17v14h-3.4z" /></svg>
                </button>
                <div class="vc-seek" id="vcSeek" role="slider" tabindex="0" aria-label="Seek video" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                  <div class="vc-fill" id="vcFill"></div>
                  <div class="vc-thumb" id="vcThumb"></div>
                </div>
              </div>
            </div>
          </div>

          <div class="pane" id="pane-walk">
            <div class="wbar">
              <div class="wsteps" id="walkSteps" role="tablist" aria-label="Walkthrough pages"></div>
              <div class="wnav">
                <button class="wbtn" id="walkPrev" type="button" aria-label="Previous page">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </button>
                <span class="wcount" id="walkCount">1 of 4</span>
                <button class="wnext hint" id="walkNext" type="button">
                  <span id="walkNextLabel">Next</span>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </button>
              </div>
            </div>
            <div class="walk" id="walk">
              <div class="wtrack" id="wtrack">
                <div class="wpage" data-title="Support &amp; resistance">
                  <div class="wshot">
                    <img src="/assets/navigator-channel.png" alt="A trend channel with support and resistance marked, plus the extended support and resistance lines further out" />
                  </div>
                  <div class="wtext">
                    <span class="weyebrow">Support and resistance</span>
                    <h3>Where the market tends to turn</h3>
                    <p>The Navigator draws the trend channel the market is moving in, then marks the support and resistance for you. Support is the floor price keeps bouncing off. Resistance is the ceiling it keeps stalling under.</p>
                    <ul class="wlist">
                      <li><span class="wm up" aria-hidden="true">▲</span><span>Price usually bounces back up off support.</span></li>
                      <li><span class="wm down" aria-hidden="true">▼</span><span>And drifts back down from resistance.</span></li>
                      <li><span class="wm ext" aria-hidden="true">◆</span><span>If a move overshoots, the extended lines further out tend to catch it.</span></li>
                    </ul>
                  </div>
                </div>
                <div class="wpage" data-title="Buy &amp; sell">
                  <div class="wshot">
                    <img src="/assets/navigator-buy-sell.png" alt="A chart channel with a blue buy signal near support and a red sell signal near resistance" />
                  </div>
                  <div class="wtext">
                    <span class="weyebrow">Buy and sell signals</span>
                    <h3>When to get in and out</h3>
                    <p>Once price bounces up off support, the Navigator prints a buy on the chart. When price turns back down from resistance, it prints a sell. You don't have to catch the turn yourself; the signal shows up for you.</p>
                    <ul class="wlist">
                      <li><span class="wm buy" aria-hidden="true">▲</span><span>A buy appears after price bounces up off support.</span></li>
                      <li><span class="wm sell" aria-hidden="true">▼</span><span>A sell appears after price turns down from resistance.</span></li>
                    </ul>
                  </div>
                </div>
                <div class="wpage" data-title="Take profit">
                  <div class="wshot">
                    <img src="/assets/navigator-take-profit.png" alt="A chart channel showing first and second take-profit targets, blue for a buy and red for a sell" />
                  </div>
                  <div class="wtext">
                    <span class="weyebrow">Profit targets</span>
                    <h3>Where to take your profit</h3>
                    <p>Every signal comes with two profit targets, set for you. The colours match the trade: blue targets belong to a buy, red targets to a sell.</p>
                    <ul class="wlist">
                      <li><span class="wm tp" aria-hidden="true">1</span><span>First target (TP1): the middle line of the channel.</span></li>
                      <li><span class="wm tp" aria-hidden="true">2</span><span>Second target (TP2): the resistance for a buy, or the support for a sell.</span></li>
                    </ul>
                  </div>
                </div>
                <div class="wpage" data-title="Stop-loss">
                  <div class="wshot">
                    <img src="/assets/navigator-stop-loss.png" alt="A chart channel with the stop-loss about one candle below support for a buy and above resistance for a sell" />
                  </div>
                  <div class="wtext">
                    <span class="weyebrow">Stop-loss</span>
                    <h3>Where to get out if you're wrong</h3>
                    <p>Every trade also gets a stop-loss, so you know your exit before you're in. It sits about one candle's height beyond the channel: below support for a buy, above resistance for a sell.</p>
                    <ul class="wlist">
                      <li><span class="wm sl" aria-hidden="true">◆</span><span>Buy: about one candle's height below the support.</span></li>
                      <li><span class="wm sl" aria-hidden="true">◆</span><span>Sell: about one candle's height above the resistance.</span></li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- ===== What you get ===== -->
  <section class="section alt" id="what-you-get">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">With your subscription</span>
        <h2>What you get <span class="hl">as a subscriber</span></h2>
        <p>The indicator is half of it. Here's the rest.</p>
      </div>
      <div class="bento">
        <div class="feat lead">
          <div class="ic"><svg viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg></div>
          <h4>Signals straight to your phone</h4>
          <p>Alerts on around 10 of the most traded names in each of your markets. The moment the Navigator prints a buy or sell, the signal lands in your private Telegram group — entry, take-profit and stop-loss worked out for you.</p>
          <div class="tg">
            <div class="tg-win" role="img" aria-label="Example of a buy alert posted to your Telegram signal group, showing the entry, two profit targets and the stop level">
              <div class="tg-top">
                <div class="tg-av" aria-hidden="true">N</div>
                <div>
                  <div class="tg-nm">US Signals · RHO Navigator</div>
                  <div class="tg-sub">Your private signal group</div>
                </div>
              </div>
              <div class="tg-body">
                <div class="tg-msg">
                  <div class="tg-sig"><span class="arr" aria-hidden="true">▲</span> BUY · NVDA <span class="tg-eg">Example</span></div>
                  <div class="tg-row"><span>Entry</span><b>176.40</b></div>
                  <div class="tg-row"><span>Targets</span><b>181.20 · 186.50</b></div>
                  <div class="tg-row"><span>Stop</span><b>172.80</b></div>
                  <div class="tg-time">9:41 AM</div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="bento-col">
          <div class="feat">
            <div class="ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a7 7 0 0 1 14 0v1"/></svg></div>
            <h4>Robin's own trades</h4>
            <p>Robin trades the Navigator himself, and posts those trades to the same group. You see how 20 years of experience reads the same chart you're looking at.</p>
          </div>
          <div class="feat">
            <div class="ic"><svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="13" rx="2"/><polygon points="10 10 15 12.5 10 15 10 10"/></svg></div>
            <h4>A live webinar every week</h4>
            <p>Robin goes through the markets live on Zoom and points out setups as they appear. Can't make it? Every session is recorded.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Pricing (full grid — same component as /pricing) ===== -->
  <section class="section" id="pricing">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Pricing</span>
        <h2>Choose your <span class="hl">markets</span></h2>
        <p>Single markets, combos, or everything. Billed quarterly, cancel anytime.</p>
      </div>

      <PriceToggle />

      <p class="pep-foot">The Pepperstone price needs only a Pepperstone account opened under our link. <a href="/free-tradingview">How it works →</a></p>
    </div>
  </section>

  <!-- ===== Free TradingView ===== -->
  <section class="section alt" id="free-tradingview">
    <div class="container split2">
      <div>
        <div class="section-head">
          <span class="eyebrow">Free TradingView</span>
          <h2>Your subscription, <span class="hl">effectively free</span></h2>
        </div>
        <p class="sub" style="color:var(--muted); max-width:48ch; margin:1rem 0 1.8rem;">The Navigator runs on TradingView. Open your Pepperstone account through us and a paid TradingView plan comes free — worth up to $99 SGD a month. That's more than most Navigator plans cost.</p>
        <a href="/free-tradingview" class="btn btn-primary">How to get it free</a>
      </div>
      <div class="offer">
        <div class="ocard">
          <div class="tvname">TradingView plan</div>
          <div class="pricerow"><span class="was">up to $99</span><span class="now">$0</span></div>
          <div class="tag">Free with Pepperstone</div>
          <div class="note">Live data, alerts, and trade the signals straight from your chart.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="section" id="faq">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">FAQ</span>
        <h2>Common <span class="hl">questions</span></h2>
      </div>
      <div class="faq-list">
        <details class="faq-item">
          <summary class="faq-q">How does the Navigator work?<svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></summary>
          <div class="faq-a"><p>It draws three lines on your chart — a ceiling (resistance), a floor (support) and a middle line — and updates them as the market moves. It also shows you the trend direction and prints buy and sell labels with suggested take-profit and stop-loss levels.</p></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Do I need to be experienced to use it?<svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></summary>
          <div class="faq-a"><p>No. The Navigator shows you the key levels and signals in plain terms, and our weekly webinars walk you through how to read and act on them. Plenty of our members were new to charts when they started.</p></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Which markets and stocks does it cover?<svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></summary>
          <div class="faq-a"><p>Hong Kong, Singapore and US stocks, plus Forex, Crypto and Metals. Once you subscribe to a market, the indicator works on any stock or instrument in that market.</p></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">How do I get the free TradingView plan?<svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></summary>
          <div class="faq-a"><p>Open a Pepperstone account through our link, add funds and place one trade. Pepperstone then gives you a paid TradingView plan free. We're happy to walk you through the setup step by step.</p></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Pepperstone isn't MAS-regulated — is my money safe?<svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></summary>
          <div class="faq-a"><p>Pepperstone answers to seven regulators, including Australia's ASIC and the UK's FCA, two of the strictest in the world. Client money sits in segregated accounts at Tier-1 banks such as Barclays, legally separate from the company's own funds, and EY audits that segregation every year. <a href="/free-tradingview#is-it-safe">The full answers are on the Free TradingView page</a>.</p></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Can I cancel anytime?<svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></summary>
          <div class="faq-a"><p>Yes. You can cancel anytime from your account page. There are no long-term contracts — your access simply runs to the end of the quarter you've paid for.</p></div>
        </details>
      </div>
      <p class="faq-more"><a href="/faq">See all questions →</a></p>
    </div>
  </section>

  <!-- ===== Final CTA ===== -->
  <section class="cta-final">
    <div class="container">
      <h2>Let's get you set up</h2>
      <p>Pick your markets and get the Navigator on your charts today.</p>
      <div class="hero-ctas">
        <a href="#pricing" class="btn btn-primary">View plans</a>
        <a href={TELEGRAM} target="_blank" rel="noopener" class="btn btn-ghost">Message us on Telegram</a>
      </div>
    </div>
  </section>

  <script>
    // Demo video: silent autoplay loop with custom controls that fade in on hover.
    const v = document.getElementById('demoVideo') as HTMLVideoElement | null;
    const playBtn = document.getElementById('vcPlay');
    const seek = document.getElementById('vcSeek');
    const fill = document.getElementById('vcFill');
    const thumb = document.getElementById('vcThumb');

    if (v && playBtn && seek && fill && thumb) {
      let userPaused = false;

      const syncBtn = () => {
        playBtn.classList.toggle('playing', !v.paused);
        playBtn.setAttribute('aria-label', v.paused ? 'Play' : 'Pause');
      };
      const toggle = () => {
        if (v.paused) {
          userPaused = false;
          v.play().catch(() => {});
        } else {
          userPaused = true;
          v.pause();
        }
      };
      const updateProgress = () => {
        if (!v.duration) return;
        const p = (v.currentTime / v.duration) * 100;
        fill.style.width = p + '%';
        thumb.style.left = p + '%';
        seek.setAttribute('aria-valuenow', String(Math.round(p)));
      };
      const seekToX = (clientX: number) => {
        const r = seek.getBoundingClientRect();
        const ratio = Math.min(1, Math.max(0, (clientX - r.left) / r.width));
        if (v.duration) {
          v.currentTime = ratio * v.duration;
          updateProgress();
        }
      };

      playBtn.addEventListener('click', toggle);
      v.addEventListener('click', toggle);
      v.addEventListener('play', syncBtn);
      v.addEventListener('pause', syncBtn);
      v.addEventListener('timeupdate', updateProgress);
      v.addEventListener('loadedmetadata', updateProgress);

      // Drag to seek
      let dragging = false;
      seek.addEventListener('pointerdown', (e) => {
        dragging = true;
        seek.classList.add('dragging');
        seek.setPointerCapture(e.pointerId);
        seekToX(e.clientX);
      });
      seek.addEventListener('pointermove', (e) => {
        if (dragging) seekToX(e.clientX);
      });
      const endDrag = (e: PointerEvent) => {
        dragging = false;
        seek.classList.remove('dragging');
        try {
          seek.releasePointerCapture(e.pointerId);
        } catch {}
      };
      seek.addEventListener('pointerup', endDrag);
      seek.addEventListener('pointercancel', endDrag);

      // Keyboard control on the seek slider
      seek.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') {
          v.currentTime = Math.min(v.duration || 0, v.currentTime + 5);
          updateProgress();
          e.preventDefault();
        } else if (e.key === 'ArrowLeft') {
          v.currentTime = Math.max(0, v.currentTime - 5);
          updateProgress();
          e.preventDefault();
        } else if (e.key === ' ' || e.key === 'Enter') {
          toggle();
          e.preventDefault();
        }
      });

      syncBtn();

      // Pause when scrolled out of view; resume only if the viewer hasn't paused.
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                if (!userPaused) v.play().catch(() => {});
              } else {
                v.pause();
              }
            }
          },
          { threshold: 0.25 }
        );
        io.observe(v);
      }
    }

    // Paged walkthrough ("How it works")
    const wtrack = document.getElementById('wtrack');
    const wprev = document.getElementById('walkPrev') as HTMLButtonElement | null;
    const wnext = document.getElementById('walkNext') as HTMLButtonElement | null;
    const wsteps = document.getElementById('walkSteps');
    const wcount = document.getElementById('walkCount');
    const wlabel = document.getElementById('walkNextLabel');

    if (wtrack && wprev && wnext && wsteps && wcount && wlabel) {
      const pages = Array.from(wtrack.children) as HTMLElement[];
      let wi = 0;
      let hinted = true;

      const stopHint = () => {
        if (hinted) {
          wnext.classList.remove('hint');
          hinted = false;
        }
      };
      const render = () => {
        wtrack.style.transform = `translateX(-${wi * 100}%)`;
        Array.from(wsteps.children).forEach((s, idx) => {
          const on = idx === wi;
          s.classList.toggle('on', on);
          s.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        wprev.disabled = wi === 0;
        const last = wi === pages.length - 1;
        wnext.disabled = last;
        // The button names the page it leads to — the visible text is the
        // accessible name, so no aria-label needed.
        wlabel.textContent = last ? 'Next' : `Next: ${pages[wi + 1].dataset.title || `page ${wi + 2}`}`;
        wcount.textContent = `${wi + 1} of ${pages.length}`;
      };
      const go = (n: number) => {
        wi = Math.max(0, Math.min(pages.length - 1, n));
        stopHint();
        render();
      };

      // Build a labelled step for each page from its data-title
      pages.forEach((p, idx) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'wstep';
        b.setAttribute('role', 'tab');
        const n = document.createElement('span');
        n.className = 'wstep-n';
        n.textContent = String(idx + 1);
        const t = document.createElement('span');
        t.className = 'wstep-t';
        t.textContent = p.dataset.title || `Page ${idx + 1}`;
        b.append(n, t);
        b.addEventListener('click', () => go(idx));
        wsteps.appendChild(b);
      });

      wprev.addEventListener('click', () => go(wi - 1));
      wnext.addEventListener('click', () => go(wi + 1));

      // Swipe / drag left-right to move between pages
      let sx = 0;
      let swiping = false;
      wtrack.addEventListener('pointerdown', (e) => {
        sx = e.clientX;
        swiping = true;
      });
      wtrack.addEventListener('pointerup', (e) => {
        if (!swiping) return;
        swiping = false;
        const dx = e.clientX - sx;
        if (Math.abs(dx) > 45) go(dx < 0 ? wi + 1 : wi - 1);
      });

      if (pages.length <= 1) wnext.classList.remove('hint');

      render();
    }
  </script>
</Base>
