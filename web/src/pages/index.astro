---
import Base from '../layouts/Base.astro';
import HeroVisual from '../components/HeroVisual.astro';
import PriceToggle from '../components/PriceToggle.astro';

// Section order follows the Navigator Preview deck's sales arc:
// hero → showcase → what you get → pricing (full grid)
// → free TradingView ("effectively free", right after the prices) → FAQ → CTA.
const TELEGRAM = 'https://t.me/Joseph_Ho';
---
<Base>
  <!-- ===== Hero ===== -->
  <header class="hero">
    <div class="hero-bg"></div>
    <div class="container">
      <div class="hero-grid">
        <div class="hero-copy">
          <span class="eyebrow fade-up" style="margin-bottom:1.4rem;"><span class="dot"></span> Built with Robin Ho · 20 years in the markets</span>
          <h1 class="fade-up" style="animation-delay:.06s;">Always a trend.<br /><span class="hl">Now you'll see it.</span></h1>
          <p class="sub fade-up" style="animation-delay:.12s;">A TradingView indicator that reads support, resistance and trend for you — and a private Telegram group that sends the buy and sell signals straight to your phone.</p>
          <div class="hero-ctas fade-up" style="animation-delay:.18s;">
            <a href="#pricing" class="btn btn-primary">View plans</a>
            <a href="#showcase" class="btn btn-ghost">See how it works</a>
          </div>
          <p class="hero-perk fade-up" style="animation-delay:.22s;"><span class="ck">✓</span> Comes with a free TradingView plan worth up to $99 SGD a month</p>
        </div>

        <!-- Compass visual — the animated product signature (HeroVisual.astro) -->
        <div class="hero-visual">
          <div class="hero-visual-scale">
            <HeroVisual />
          </div>
        </div>
      </div>
    </div>

    <!-- floating market strip -->
    <div class="market-strip">
      <div class="schip"><span class="d"></span>Hong Kong</div>
      <div class="schip"><span class="d"></span>Singapore</div>
      <div class="schip"><span class="d"></span>US</div>
      <div class="schip"><span class="d"></span>Forex · Crypto · Metals</div>
    </div>
  </header>

  <!-- ===== Showcase ===== -->
  <section class="showcase" id="showcase">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">The indicator</span>
        <h2>See it work <span class="hl">in real time</span></h2>
        <p>Live support, resistance and trend — redrawn the moment price moves.</p>
      </div>

      <div class="tabs">
        <button class="tab on" data-pane="pane-live"><span class="live-dot"></span> Live demo</button>
        <button class="tab" data-pane="pane-annot">What you're seeing</button>
        <button class="tab" data-pane="pane-how">How it works</button>
      </div>

      <div class="stage">
        <div class="glow"></div>
        <div class="glow top"></div>
        <div class="media">
          <div class="pane on" id="pane-live">
            <div class="media-bar">
              <span class="live"><span class="pulse"></span>LIVE</span>
              <span class="sym">DBS · D05 · 1H</span>
              <span class="right">adapting in real time</span>
            </div>
            <div class="shot">
              <img src="/assets/navigator_channels.png" alt="RHO Navigator drawing trend channels and buy/sell labels on a live chart" />
              <div class="play-overlay" id="playOverlay">
                <div class="play-circle"><span class="play-tri"></span></div>
                <span class="play-cap">Watch the 60-second demo</span>
              </div>
            </div>
            <div class="media-foot"><span class="t">live</span><span class="track"></span><span class="t">auto-loop</span></div>
          </div>

          <div class="pane" id="pane-annot">
            <div class="media-bar"><span class="sym">DBS · D05 · 1H</span><span class="right">what each part means</span></div>
            <div class="annot">
              <div class="shot">
                <img src="/assets/channels_ulti.png" alt="Annotated RHO Navigator chart" />
                <span class="pin" style="left:33%; top:17%;">1</span>
                <span class="pin" style="left:21%; top:77%;">2</span>
                <span class="pin" style="left:40%; top:34%;">3</span>
                <span class="pin" style="left:92%; top:91%;">4</span>
              </div>
              <div class="callouts">
                <div class="callout"><span class="num">1</span><span><b>Resistance</b><span>The ceiling — where price often stops rising.</span></span></div>
                <div class="callout"><span class="num">2</span><span><b>Support</b><span>The floor — where price often bounces back up.</span></span></div>
                <div class="callout"><span class="num">3</span><span><b>Buy / sell signal</b><span>Tells you when to get in or out, in plain words.</span></span></div>
                <div class="callout"><span class="num">4</span><span><b>Take-profit &amp; stop-loss</b><span>Your exit levels, worked out for you.</span></span></div>
              </div>
            </div>
          </div>

          <div class="pane" id="pane-how">
            <div class="media-bar"><span class="sym">From the chart to your phone</span></div>
            <div class="steps">
              <div class="step"><div class="si">1</div><h4>Reads the trend</h4><p>Shades the channel and tells you, in one word, which way the market is leaning.</p></div>
              <div class="step"><div class="si">2</div><h4>Marks buy &amp; sell</h4><p>Prints clear labels on the chart the moment a setup appears.</p></div>
              <div class="step"><div class="si">3</div><h4>Sets your exits</h4><p>Shows take-profit and stop-loss levels, worked out for you.</p></div>
              <div class="step"><div class="si">4</div><h4>Pings your phone</h4><p>Sends the same signals to your Telegram group, so you never miss one.</p></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== What you get ===== -->
  <section class="section alt" id="what-you-get">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">With your subscription</span>
        <h2>What you get <span class="hl">as a subscriber</span></h2>
        <p>The indicator is half of it. Here's the rest.</p>
      </div>
      <div class="feat3">
        <div class="feat">
          <div class="ic"><svg viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg></div>
          <h4>Signals to your phone</h4>
          <p>Alerts on around 10 of the most traded names in each of your markets. The moment the Navigator prints a buy or sell, the signal lands in your private Telegram group.</p>
        </div>
        <div class="feat">
          <div class="ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a7 7 0 0 1 14 0v1"/></svg></div>
          <h4>Robin's own trades</h4>
          <p>Robin trades the Navigator himself, and posts those trades to the same group. You see how 20 years of experience reads the same chart you're looking at.</p>
        </div>
        <div class="feat">
          <div class="ic"><svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="13" rx="2"/><polygon points="10 10 15 12.5 10 15 10 10"/></svg></div>
          <h4>A live webinar every week</h4>
          <p>Robin goes through the markets live on Zoom and points out setups as they appear. Can't make it? Every session is recorded.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Pricing (full grid — same component as /pricing) ===== -->
  <section class="section" id="pricing">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Pricing</span>
        <h2>Choose your <span class="hl">markets</span></h2>
        <p>Single markets, combos, or everything. Billed quarterly, cancel anytime.</p>
      </div>

      <PriceToggle />

      <p class="pep-foot">The Pepperstone price needs only a Pepperstone account opened under our link. <a href="/free-tradingview">How it works →</a></p>
    </div>
  </section>

  <!-- ===== Free TradingView ===== -->
  <section class="section alt" id="free-tradingview">
    <div class="container split2">
      <div>
        <div class="section-head">
          <span class="eyebrow">Free TradingView</span>
          <h2>Your subscription, <span class="hl">effectively free</span></h2>
        </div>
        <p class="sub" style="color:var(--muted); max-width:48ch; margin:1rem 0 1.8rem;">The Navigator runs on TradingView. Open your Pepperstone account through us and a paid TradingView plan comes free — worth up to $99 SGD a month. That's more than most Navigator plans cost.</p>
        <a href="/free-tradingview" class="btn btn-primary">How to get it free</a>
      </div>
      <div class="offer">
        <div class="ocard">
          <div class="tvname">TradingView plan</div>
          <div class="pricerow"><span class="was">up to $99</span><span class="now">$0</span></div>
          <div class="tag">Free with Pepperstone</div>
          <div class="note">Live data, alerts, and trade the signals straight from your chart.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="section" id="faq">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">FAQ</span>
        <h2>Common <span class="hl">questions</span></h2>
      </div>
      <div class="faq-list">
        <div class="faq-item">
          <button class="faq-q">How does the Navigator work?<svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></button>
          <div class="faq-a"><p>It draws three lines on your chart — a ceiling (resistance), a floor (support) and a middle line — and updates them as the market moves. It also shows you the trend direction and prints buy and sell labels with suggested take-profit and stop-loss levels.</p></div>
        </div>
        <div class="faq-item">
          <button class="faq-q">Do I need to be experienced to use it?<svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></button>
          <div class="faq-a"><p>No. The Navigator shows you the key levels and signals in plain terms, and our weekly webinars walk you through how to read and act on them. Plenty of our members were new to charts when they started.</p></div>
        </div>
        <div class="faq-item">
          <button class="faq-q">Which markets and stocks does it cover?<svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></button>
          <div class="faq-a"><p>Hong Kong, Singapore and US stocks, plus Forex, Crypto and Metals. Once you subscribe to a market, the indicator works on any stock or instrument in that market.</p></div>
        </div>
        <div class="faq-item">
          <button class="faq-q">How do I get the free TradingView plan?<svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></button>
          <div class="faq-a"><p>Open a Pepperstone account through our link, add funds and place one trade. Pepperstone then gives you a paid TradingView plan free. We're happy to walk you through the setup step by step.</p></div>
        </div>
        <div class="faq-item">
          <button class="faq-q">Pepperstone isn't MAS-regulated — is my money safe?<svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></button>
          <div class="faq-a"><p>Pepperstone answers to seven regulators, including Australia's ASIC and the UK's FCA, two of the strictest in the world. Client money sits in segregated accounts at Tier-1 banks such as Barclays, legally separate from the company's own funds, and EY audits that segregation every year. <a href="/free-tradingview#is-it-safe">The full answers are on the Free TradingView page</a>.</p></div>
        </div>
        <div class="faq-item">
          <button class="faq-q">Can I cancel anytime?<svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></button>
          <div class="faq-a"><p>Yes. You can cancel anytime from your account page. There are no long-term contracts — your access simply runs to the end of the quarter you've paid for.</p></div>
        </div>
      </div>
      <p class="faq-more"><a href="/faq">See all questions →</a></p>
    </div>
  </section>

  <!-- ===== Final CTA ===== -->
  <section class="cta-final">
    <div class="container">
      <h2>Ready to spot the turn?</h2>
      <p>Pick your markets and get the Navigator on your charts today.</p>
      <div class="hero-ctas">
        <a href="#pricing" class="btn btn-primary">View plans</a>
        <a href={TELEGRAM} target="_blank" rel="noopener" class="btn btn-ghost">Message us on Telegram</a>
      </div>
    </div>
  </section>
</Base>
