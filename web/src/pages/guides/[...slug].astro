---
import Base from '../../layouts/Base.astro';
import DocsSidebar from '../../components/guides/DocsSidebar.astro';
import { getCollection, render } from 'astro:content';
import '../../styles/docs.css';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);

const track = guide.data.track;
// hub link differs per track (Set Up vs Master vs Trading with Pepperstone)
const hub = track === 'master'
  ? { href: '/guides/master', label: '← Master the Navigator' }
  : track === 'trading'
  ? { href: '/guides/trading', label: '← Trading with Pepperstone' }
  : { href: '/guides/setup', label: '← Set up' };

// Sidebar data: every step in THIS track with its sub-step anchors (the h2s of its body).
const all = (await getCollection('guides'))
  .filter((g) => g.data.track === track)
  .sort((a, b) => a.data.order - b.data.order);
const steps = await Promise.all(
  all.map(async (g, i) => {
    const rendered = await render(g);
    return {
      id: g.id,
      title: g.data.title,
      number: i + 1,
      headings: rendered.headings
        .filter((h) => h.depth === 2)
        .map((h) => ({ slug: h.slug, text: h.text })),
    };
  })
);

const idx = all.findIndex((g) => g.id === guide.id);
const prev = idx > 0 ? all[idx - 1] : undefined;
const next = idx < all.length - 1 ? all[idx + 1] : undefined;
const stepLabel = guide.data.step ?? `Step ${idx + 1}`;
const eyebrow = `${stepLabel} of ${all.length}`;
// At the end of a track, point readers onward. Set Up ends with two doors,
// stacked and labelled by what they teach: Trading with Pepperstone (how CFD
// trading works — leverage, margin, fees) then Master the Navigator (the indicator).
// Trading with Pepperstone ends pointing at Master; Master ends pointing at
// Trading with Pepperstone — once you can read the signals, the next skill is
// placing the trade.
const endCtas =
  track === 'setup' && !next
    ? [
        { href: '/guides/trading', dir: 'Leverage, margin and fees →', title: 'Trading with Pepperstone', primary: false },
        { href: '/guides/master', dir: 'Read the chart and signals →', title: 'Master the Navigator', primary: true },
      ]
    : track === 'trading' && !next
    ? [{ href: '/guides/master', dir: 'You can trade now →', title: 'Master the Navigator', primary: true }]
    : track === 'master' && !next
    ? [{ href: '/guides/trading', dir: 'Ready to place a trade? →', title: 'Learn how to trade with Pepperstone', primary: true }]
    : [];
---
<Base compact title={`${guide.data.title} — RHO Navigator`} description={guide.data.description}>
  <div class="docs-shell">
    <div class="container docs-layout">
      <aside class="docs-side">
        <DocsSidebar steps={steps} currentId={guide.id} hubHref={hub.href} hubLabel={hub.label} />
      </aside>

      <article class="docs-main">
        <header class="docs-head">
          <span class="eyebrow">{eyebrow}</span>
          <h1>{guide.data.title}</h1>
          {!guide.data.hideLede && <p class="docs-lede">{guide.data.description}</p>}
        </header>

        <details class="docs-nav-mobile">
          <summary>All steps</summary>
          <DocsSidebar steps={steps} currentId={guide.id} hubHref={hub.href} hubLabel={hub.label} />
        </details>

        <div class="docs-prose" style={guide.data.shotScale ? `--shot-scale: ${guide.data.shotScale}` : undefined}>
          <Content />
        </div>

        <nav class="docs-pager" aria-label="Step navigation">
          {prev && (
            <a class="pg pg-prev" href={`/guides/${prev.id}`}>
              <span class="pg-dir">← Previous step</span>
              <span class="pg-title">{prev.data.title}</span>
            </a>
          )}
          {next && (
            <a class="pg pg-next" href={`/guides/${next.id}`}>
              <span class="pg-dir">Next step →</span>
              <span class="pg-title">{next.data.title}</span>
            </a>
          )}
          {/* A lone onward CTA rides in the pager's right column, same size as a
              next link. Two or more get the stacked block below instead. */}
          {endCtas.length === 1 && (
            <a class="pg pg-next pg-cta" href={endCtas[0].href}>
              <span class="pg-dir">{endCtas[0].dir}</span>
              <span class="pg-title">{endCtas[0].title}</span>
            </a>
          )}
        </nav>

        {endCtas.length > 1 && (
          <section class="docs-next" aria-label="Where to next">
            <p class="docs-next-eyebrow">Where to next?</p>
            <div class="docs-next-grid">
              {endCtas.map((c) => (
                <a class={`pg${c.primary ? ' pg-cta' : ''}`} href={c.href}>
                  <span class="pg-dir">{c.dir}</span>
                  <span class="pg-title">{c.title}</span>
                </a>
              ))}
            </div>
          </section>
        )}

        {!next && (
          <p class="docs-allguides"><a class="hub-back" href="/guides">← Back to all guides</a></p>
        )}

        <p class="docs-help">
          Stuck anywhere? <a href="https://t.me/Joseph_Ho" target="_blank" rel="noopener noreferrer">Message us on Telegram</a> and we'll walk you through it.
        </p>
      </article>
    </div>
  </div>

  <script>
    // Scrollspy: highlight the sidebar sub-step that's currently on screen.
    // data-anchor is only set on the current page's links (both sidebar copies).
    const links = document.querySelectorAll<HTMLAnchorElement>('.docs-nav a[data-anchor]');
    if (links.length) {
      const slugs = [...new Set([...links].map((l) => l.dataset.anchor!))];
      const heads = slugs
        .map((slug) => document.getElementById(slug))
        .filter((el): el is HTMLElement => !!el);
      let active = '';
      const update = () => {
        let current = '';
        for (const h of heads) {
          if (h.getBoundingClientRect().top <= 130) current = h.id;
        }
        if (current === active) return;
        active = current;
        links.forEach((l) => l.classList.toggle('on', l.dataset.anchor === current));
      };
      window.addEventListener('scroll', update, { passive: true });
      update();
    }
  </script>
</Base>
