---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
---
<Base title={`${guide.data.title} — RHO Navigator`} description={guide.data.description}>
  <section class="page-hero">
    <div class="container">
      {guide.data.step && <span class="eyebrow">{guide.data.step}</span>}
      <h1>{guide.data.title}</h1>
      <p>{guide.data.description}</p>
    </div>
  </section>

  <article class="container">
    <div class="prose">
      <a class="back" href="/guides">← All guides</a>
      <Content />
    </div>
  </article>
</Base>
