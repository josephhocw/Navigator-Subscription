---
import Base from '../../layouts/Base.astro';
import DocsSidebar from '../../components/guides/DocsSidebar.astro';
import { getCollection, render } from 'astro:content';
import '../../styles/docs.css';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);

const track = guide.data.track;
// Trading-terminal walkthroughs (Pepperstone Webtrader/cTrader) are standalone
// alternatives that hang off the "Your trading terminal" hub, not numbered
// Learn-to-Trade steps.
const isTerminal = track === 'trading-terminal';
// hub link differs per track (Set Up vs Master vs Learn to Trade vs terminal pages)
const hub = track === 'master'
  ? { href: '/guides/master', label: '← Master the Navigator' }
  : track === 'trading'
  ? { href: '/guides/trading', label: '← Learn to Trade' }
  : isTerminal
  ? { href: '/guides/trading/your-trading-terminal', label: '← Your trading terminal' }
  : { href: '/guides', label: '← All steps' };

// Sidebar data: every step in THIS track with its sub-step anchors (the h2s of its body).
const all = (await getCollection('guides'))
  .filter((g) => g.data.track === track)
  .sort((a, b) => a.data.order - b.data.order);
// On a terminal page the sidebar shows only that page's own sections — a reader
// never sees the other terminal's walkthrough.
const sidebarPages = isTerminal ? all.filter((g) => g.id === guide.id) : all;
const steps = await Promise.all(
  sidebarPages.map(async (g, i) => {
    const rendered = await render(g);
    return {
      id: g.id,
      title: g.data.title,
      number: i + 1,
      headings: rendered.headings
        .filter((h) => h.depth === 2)
        .map((h) => ({ slug: h.slug, text: h.text })),
    };
  })
);

const idx = all.findIndex((g) => g.id === guide.id);
// Terminal pages are alternatives, not a sequence — no prev/next stepping between them.
const prev = !isTerminal && idx > 0 ? all[idx - 1] : undefined;
const next = !isTerminal && idx < all.length - 1 ? all[idx + 1] : undefined;
const stepLabel = guide.data.step ?? `Step ${idx + 1}`;
const eyebrow = isTerminal ? stepLabel : `${stepLabel} of ${all.length}`;
// At the end of the Set Up track, point people on to the Master track.
const toMaster = track === 'setup' && !next;
---
<Base title={`${guide.data.title} — RHO Navigator`} description={guide.data.description}>
  <div class="docs-shell">
    <div class="container docs-layout">
      <aside class="docs-side">
        <DocsSidebar steps={steps} currentId={guide.id} hubHref={hub.href} hubLabel={hub.label} />
      </aside>

      <article class="docs-main">
        <header class="docs-head">
          <span class="eyebrow">{eyebrow}</span>
          <h1>{guide.data.title}</h1>
          {!guide.data.hideLede && <p class="docs-lede">{guide.data.description}</p>}
        </header>

        <details class="docs-nav-mobile">
          <summary>All steps</summary>
          <DocsSidebar steps={steps} currentId={guide.id} hubHref={hub.href} hubLabel={hub.label} />
        </details>

        <div class="docs-prose">
          <Content />
        </div>

        <nav class="docs-pager" aria-label="Step navigation">
          {isTerminal && (
            <a class="pg pg-prev" href="/guides/trading/your-trading-terminal">
              <span class="pg-dir">← Back</span>
              <span class="pg-title">Your trading terminal</span>
            </a>
          )}
          {prev && (
            <a class="pg pg-prev" href={`/guides/${prev.id}`}>
              <span class="pg-dir">← Previous step</span>
              <span class="pg-title">{prev.data.title}</span>
            </a>
          )}
          {next && (
            <a class="pg pg-next" href={`/guides/${next.id}`}>
              <span class="pg-dir">Next step →</span>
              <span class="pg-title">{next.data.title}</span>
            </a>
          )}
          {toMaster && (
            <a class="pg pg-next pg-cta" href="/guides/master">
              <span class="pg-dir">You're all set up →</span>
              <span class="pg-title">Master the Navigator</span>
            </a>
          )}
        </nav>

        <p class="docs-help">
          Stuck anywhere? <a href="https://t.me/Joseph_Ho">Message us on Telegram</a> and we'll walk you through it.
        </p>
      </article>
    </div>
  </div>

  <script>
    // Scrollspy: highlight the sidebar sub-step that's currently on screen.
    // data-anchor is only set on the current page's links (both sidebar copies).
    const links = document.querySelectorAll<HTMLAnchorElement>('.docs-nav a[data-anchor]');
    if (links.length) {
      const slugs = [...new Set([...links].map((l) => l.dataset.anchor!))];
      const heads = slugs
        .map((slug) => document.getElementById(slug))
        .filter((el): el is HTMLElement => !!el);
      let active = '';
      const update = () => {
        let current = '';
        for (const h of heads) {
          if (h.getBoundingClientRect().top <= 130) current = h.id;
        }
        if (current === active) return;
        active = current;
        links.forEach((l) => l.classList.toggle('on', l.dataset.anchor === current));
      };
      window.addEventListener('scroll', update, { passive: true });
      update();
    }
  </script>
</Base>
