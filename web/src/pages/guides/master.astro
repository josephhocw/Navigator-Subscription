---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

// Illustrated timeline: each stage card carries a chart screenshot from inside
// the guide (frontmatter hubThumb) and a scope line — hubMeta when set, else
// "N sections" computed from the guide's ## headings.
const stages = await Promise.all(
  (await getCollection('guides'))
    .filter((g) => g.data.track === 'master')
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (g) => {
      const { headings } = await render(g);
      const sections = headings.filter((h) => h.depth === 2).length;
      return { ...g, meta: g.data.hubMeta ?? `${sections} sections` };
    })
);
---
<Base
  title="Master the Navigator — RHO Navigator"
  description="Trade well with the Navigator: understand every feature, build the four core skills, and act on the Telegram signals."
>
  <section class="page-hero">
    <div class="container">
      <a class="hub-back" href="/guides">← All guides</a>
      <h1>Master the Navigator</h1>
      <p>Start by understanding every feature on the chart, then build the four core skills. Those four are what trading the Navigator well really comes down to. The Telegram signals and your own alerts come after. Work through the stages in order, or jump to the one you need.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ol class="timeline">
        {stages.map((g, i) => (
          <li class="tl-step">
            <span class="tl-badge" aria-hidden="true">{i + 1}</span>
            <a class:list={['tl-body', 'tl-card', { 'tl-card--full': !g.data.hubThumb }]} href={`/guides/${g.id}`}>
              <span class="tl-main">
                <span class="tl-meta">{g.meta}</span>
                <span class="tl-title">
                  {g.data.title}
                  {g.data.wip && <span class="tl-wip">Work in progress</span>}
                </span>
                <span class="tl-desc">{g.data.description}</span>
                <span class="tl-go">{g.data.wip ? 'Preview this stage →' : 'Start this stage →'}</span>
              </span>
              {g.data.hubThumb && (
                <span class="tl-thumb">
                  <img src={g.data.hubThumb} alt="" loading="lazy" />
                </span>
              )}
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<style>
  /* Close the hero → first-card gap on this hub. The defaults
     (.page-hero 50px bottom + .section 90px top) stack to ~140px here. */
  .page-hero { padding-bottom: 24px; }
  .section { padding-top: 26px; }

  /* Two-column card: text left, chart thumbnail right. Padding moves to
     .tl-main so the thumbnail can bleed to the card edge. No overflow:hidden
     here — it would clip the hover halo (.tl-body::after in global.css) — so
     the thumbnail rounds its own outer corners instead. */
  .tl-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    align-items: stretch;
    padding: 0;
  }
  .tl-card--full { grid-template-columns: 1fr; }
  .tl-main { display: block; min-width: 0; padding: 0.95rem 1.6rem 1.1rem; }

  /* scope line above the title, e.g. "5 sections" */
  .tl-meta {
    display: block;
    color: var(--muted);
    font-size: 0.88rem;
    font-weight: 600;
    margin-bottom: 0.3rem;
  }

  .tl-thumb {
    position: relative;
    background: var(--surface-2);
    border-left: 1px solid var(--line);
    border-radius: 0 calc(var(--radius) - 1px) calc(var(--radius) - 1px) 0;
    overflow: hidden;
  }
  .tl-thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left center;
    opacity: 0.9;
  }
  /* fade the screenshot into the card so the text edge stays clean */
  .tl-thumb::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(14, 23, 41, 0.55), rgba(14, 23, 41, 0) 45%);
  }

  @media (max-width: 760px) {
    .tl-card { grid-template-columns: 1fr; }
    .tl-thumb {
      order: -1;
      min-height: 140px;
      border-left: none;
      border-bottom: 1px solid var(--line);
      border-radius: calc(var(--radius) - 1px) calc(var(--radius) - 1px) 0 0;
    }
    .tl-thumb::after { background: linear-gradient(180deg, rgba(14, 23, 41, 0), rgba(14, 23, 41, 0.4)); }
  }

  /* "Work in progress" badge beside the stage title */
  .tl-wip {
    display: inline-block;
    margin-left: 10px;
    padding: 2px 9px;
    border-radius: 999px;
    background: rgba(245, 158, 11, 0.14);
    border: 1px solid rgba(245, 158, 11, 0.35);
    color: #fbbf24;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    vertical-align: middle;
    white-space: nowrap;
  }
</style>
