---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const stages = (await getCollection('guides'))
  .filter((g) => g.data.track === 'master')
  .sort((a, b) => a.data.order - b.data.order);
---
<Base
  title="Master the Navigator — RHO Navigator"
  description="Trade well with the Navigator: understand every feature, build the four core skills, sharpen them with the tips, and act on the Telegram signals."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Guides</span>
      <h1>Master the Navigator</h1>
      <p>Start by understanding every feature on the chart, then build the four core skills. Those four are what trading the Navigator well really comes down to. The tips, the Telegram signals and your own alerts come after. Work through the stages in order, or jump to the one you need.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ol class="timeline">
        {stages.map((g, i) => (
          <li class="tl-step">
            <span class="tl-badge" aria-hidden="true">{i + 1}</span>
            <a class="tl-body" href={`/guides/${g.id}`}>
              <span class="tl-title">
                {g.data.title}
                {g.data.wip && <span class="tl-wip">Work in progress</span>}
              </span>
              <span class="tl-desc">{g.data.description}</span>
              <span class="tl-go">{g.data.wip ? 'Preview this stage →' : 'Start this stage →'}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<style>
  /* Close the hero → first-card gap on this hub. The defaults
     (.page-hero 50px bottom + .section 90px top) stack to ~140px here. */
  .page-hero { padding-bottom: 24px; }
  .section { padding-top: 26px; }

  /* "Work in progress" badge beside the stage title */
  .tl-wip {
    display: inline-block;
    margin-left: 10px;
    padding: 2px 9px;
    border-radius: 999px;
    background: rgba(245, 158, 11, 0.14);
    border: 1px solid rgba(245, 158, 11, 0.35);
    color: #fbbf24;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    vertical-align: middle;
    white-space: nowrap;
  }
</style>
