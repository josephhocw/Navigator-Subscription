---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const guides = await getCollection('guides');
const countIn = (t) => guides.filter((g) => g.data.track === t).length;

// Icons mirror the nav dropdown so the overview reads as the same system:
// cube = set up, star = master, chart line = trade.
const icons = {
  setup: '<path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z"/><path d="M12 12l8-4.5M12 12v9M12 12L4 7.5"/>',
  master: '<path d="M12 3l2.2 4.6 5 .7-3.6 3.5.9 5-4.5-2.4L7.4 17l.9-5L4.7 8.3l5-.7L12 3z"/>',
  trade: '<path d="M4 16l4-5 4 3 5-7"/><path d="M14 7h4v4"/><path d="M4 20h16"/>',
};

// Three cards, all in view at once. Order = the natural path (set up → master →
// trade), but any can be entered directly. Set up is the featured "start here";
// each card's badge signals who it's for.
const tracks = [
  {
    href: '/guides/setup',
    icon: 'setup',
    featured: true,
    badge: 'Start here',
    name: 'Set up',
    prompt: "I'm getting started — including signing up.",
    blurb: 'Open your Pepperstone account, subscribe, set up TradingView and Telegram, and get the Navigator onto your charts.',
    meta: `${countIn('setup')} steps`,
  },
  {
    href: '/guides/master',
    icon: 'master',
    featured: false,
    badge: 'Every subscriber',
    name: 'Master the Navigator',
    prompt: "I'm subscribed — help me use the Navigator.",
    blurb: 'Understand every feature on the chart, build the four core skills, and act on the Telegram signals with confidence.',
    meta: `${countIn('master')} stages`,
  },
  {
    href: '/guides/trading',
    icon: 'trade',
    featured: false,
    badge: 'For all levels',
    name: 'Trading with Pepperstone',
    prompt: 'Pepperstone or TradingView is new to me.',
    blurb: 'How trading works on Pepperstone and TradingView — leverage, margin, fees, order types, and placing your first trade.',
    meta: `${countIn('trading')} steps`,
  },
];
---
<Base
  title="Guides — RHO Navigator"
  description="Three plain-English guides through the Navigator: get set up (and subscribed), master the chart and signals, and trade on Pepperstone. Start wherever you are."
>
  <section class="page-hero gv-hero">
    <div class="container">
      <span class="eyebrow">Guides</span>
      <h1>Where should you <span class="gv-grad">start</span>?</h1>
      <p>Three guides through the Navigator, each a plain-English walkthrough. Pick the one that sounds like you.</p>
      <p class="gv-hint">Most people start with Set up and work along in order — but you can jump in wherever fits.</p>
    </div>
  </section>

  <section class="section gv-section">
    <div class="container">
      <div class="gv-grid">
        {tracks.map((t) => (
          <a class:list={['gv-card', { 'gv-card--featured': t.featured }]} href={t.href}>
            <span class="gv-top">
              <span class="gv-ico" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[t.icon]} />
              </span>
              <span class="gv-badge">{t.badge}</span>
            </span>
            <span class="gv-name">{t.name}</span>
            <span class="gv-prompt">{t.prompt}</span>
            <span class="gv-blurb">{t.blurb}</span>
            <span class="gv-foot">
              <span class="gv-count">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6h11M8 12h11M8 18h11"/><path d="M3.5 6h.01M3.5 12h.01M3.5 18h.01"/></svg>
                {t.meta}
              </span>
              <span class:list={['gv-start', t.featured ? 'gv-start--primary' : 'gv-start--ghost']}>
                Start
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
              </span>
            </span>
          </a>
        ))}
      </div>

      <p class="gv-foot-note">Not sure where you fit? Start with <a href="/guides/setup">Set up</a> — it covers signing up and gets everything running.</p>
    </div>
  </section>
</Base>

<style>
  /* ===== /guides overview — a three-card grid, all in view at once ===== */
  .gv-hero { padding-bottom: 26px; }
  .gv-grad { background: var(--grad-text); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .gv-hint { margin: 0.9rem auto 0; color: var(--muted); font-size: 0.95rem; max-width: 56ch; }

  .gv-section { padding-top: 30px; }
  .gv-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.1rem; max-width: 1120px; margin: 0 auto; align-items: stretch; }

  .gv-card {
    display: flex; flex-direction: column; height: 100%;
    padding: 1.5rem 1.4rem;
    background: var(--surface); border: 1px solid var(--line); border-radius: 16px;
    text-decoration: none; color: inherit;
    transition: transform 0.18s var(--ease), border-color 0.18s ease, box-shadow 0.18s ease;
  }
  /* featured "start here" card: gradient border + soft blue glow */
  .gv-card--featured {
    border-color: transparent;
    background: linear-gradient(var(--surface), var(--surface)) padding-box, var(--grad-primary) border-box;
    box-shadow: 0 24px 60px -34px var(--glow-blue);
  }

  .gv-top { display: flex; align-items: center; justify-content: space-between; gap: 0.8rem; margin-bottom: 1rem; }
  .gv-ico {
    width: 46px; height: 46px; border-radius: 11px; display: grid; place-items: center;
    background: rgba(56, 189, 248, 0.10); border: 1px solid rgba(56, 189, 248, 0.28); color: var(--cyan-light);
  }
  .gv-card--featured .gv-ico { background: var(--grad-primary); border-color: transparent; color: #fff; }
  .gv-badge {
    font-size: 0.68rem; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; color: var(--cyan-light);
    background: rgba(56, 189, 248, 0.12); border: 1px solid rgba(56, 189, 248, 0.32);
    padding: 4px 10px; border-radius: var(--radius-pill); white-space: nowrap;
  }

  /* the guide name — the big scan-in-one-glance heading */
  .gv-name { display: block; color: #fff; font-size: clamp(1.3rem, 1.7vw, 1.5rem); font-weight: 700; line-height: 1.2; letter-spacing: -0.015em; }
  /* the "is this me?" hook under the name */
  .gv-prompt { display: block; margin-top: 0.5rem; color: var(--cyan-light); font-size: 0.98rem; font-weight: 600; line-height: 1.4; }
  .gv-blurb { display: block; margin-top: 0.6rem; color: var(--text); font-size: 0.98rem; line-height: 1.5; }

  .gv-foot { margin-top: auto; padding-top: 1.3rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .gv-count { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); font-size: 0.88rem; font-weight: 600; }
  .gv-count svg { color: var(--cyan); }
  .gv-start { display: inline-flex; align-items: center; gap: 7px; padding: 0.72rem 1.2rem; border-radius: var(--radius-pill); font-weight: 700; font-size: 0.98rem; white-space: nowrap; }
  .gv-start--primary { background: var(--grad-primary); color: #fff; box-shadow: 0 12px 26px -14px var(--glow-blue); }
  .gv-start--ghost { background: transparent; color: var(--cyan-light); border: 1px solid var(--line-strong); }

  .gv-foot-note { text-align: center; margin: 2rem 0 0; color: var(--muted); font-size: 1rem; }
  .gv-foot-note a { color: var(--cyan-light); font-weight: 700; }
  .gv-foot-note a:hover { text-decoration: underline; }

  .gv-card:focus-visible { outline: 3px solid var(--cyan-light); outline-offset: 3px; }
  @media (hover: hover) {
    .gv-card:hover { border-color: rgba(56, 189, 248, 0.4); }
    .gv-card--featured:hover { box-shadow: 0 28px 66px -30px var(--glow-blue); }
    .gv-card:hover .gv-start--primary { filter: brightness(1.06); }
    .gv-card:hover .gv-start--ghost { border-color: var(--cyan); color: #fff; }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .gv-card:hover { transform: translateY(-3px); }
  }

  /* stack to one column on tablet/mobile */
  @media (max-width: 920px) {
    .gv-grid { grid-template-columns: 1fr; max-width: 620px; }
    .gv-card { padding: 1.4rem 1.4rem; }
    .gv-foot { padding-top: 1.5rem; }
    .gv-start { min-height: 48px; }
  }
  @media (max-width: 420px) {
    .gv-ico { width: 44px; height: 44px; }
    .gv-name { font-size: 1.25rem; }
  }
</style>
