---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides')).sort(
  (a, b) => a.data.order - b.data.order
);
---
<Base
  title="Guides — RHO Navigator"
  description="The full setup path, step by step: open Pepperstone, set up TradingView and Telegram, subscribe, and get the Navigator on your charts."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Guides</span>
      <h1>Set up, step by step</h1>
      <p>Follow the steps in order and you'll go from nothing to trading with the Navigator on your charts. Each step is a plain-English walkthrough — just follow along.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ol class="timeline">
        {guides.map((g, i) => (
          <li class="tl-step">
            <span class="tl-badge" aria-hidden="true">{i + 1}</span>
            <a class="tl-body" href={`/guides/${g.id}`}>
              <span class="tl-title">{g.data.title}</span>
              <span class="tl-desc">{g.data.description}</span>
              <span class="tl-go">Start this step →</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>
