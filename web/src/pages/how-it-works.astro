/* ============ MOTION ============ */
/* active-setup candles draw in; label pills pop after */
.cset{display:none}
.cset.active{display:block}
.cset.active .candle{
  opacity:0;
  animation:candleIn .5s ease forwards;
}
.cset.active .pill-group{
  opacity:0;
  animation:pillIn .5s ease forwards;
}
@keyframes candleIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
@keyframes pillIn{from{opacity:0;transform:translateY(8px) scale(.92)}to{opacity:1;transform:translateY(0) scale(1)}}

@media (prefers-reduced-motion:reduce){
  .cset.active .candle,.cset.active .pill-group{opacity:1 !important;transform:none !important}
  .screen-live .pulse{animation:none}
  .port-week .reveal{opacity:1 !important;transform:none !important}
}
</style>

<script>
  (function(){
    "use strict";

    /* ---------- signal card values per setup (illustrative) ---------- */
    var sigData = {
      buy:  { pill:"Buy ▲", pillClass:"buy",  word:"zone reached", inst:"AAPL · 15-minute chart",
              price:"232.40", tp1:"236.10", tp2:"240.50", sl:"229.80" },
      sell: { pill:"Sell ▼", pillClass:"sell", word:"zone reached", inst:"AAPL · 15-minute chart",
              price:"244.70", tp1:"240.90", tp2:"236.40", sl:"247.30" },
      brk:  { pill:"Breakout ▲", pillClass:"brk", word:"confirmed", inst:"AAPL · 15-minute chart",
              price:"249.10", tp1:"253.60", tp2:"258.20", sl:"246.40" }
    };

    /* ---------- tab switching ---------- */
    var tabs = Array.prototype.slice.call(document.querySelectorAll(".setup-tab"));
    var panels = { buy:document.getElementById("panel-buy"), sell:document.getElementById("panel-sell"), brk:document.getElementById("panel-brk") };
    var caps   = { buy:document.getElementById("cap-buy"), sell:document.getElementById("cap-sell"), brk:document.getElementById("cap-brk") };

    function setActive(key){
      tabs.forEach(function(t){
        var on = t.dataset.set === key;
        t.setAttribute("aria-selected", on ? "true" : "false");
        t.tabIndex = on ? 0 : -1;
      });
      // panels: retrigger the draw-in animation by toggling the class
      Object.keys(panels).forEach(function(k){
        var p = panels[k];
        p.classList.remove("active");
        caps[k].hidden = true;
      });
      // force reflow so animation restarts
      void panels[key].getBoundingClientRect();
      panels[key].classList.add("active");
      caps[key].hidden = false;

      // update signal card
      var d = sigData[key];
      var pill = document.getElementById("sig-pill");
      pill.textContent = d.pill;
      pill.className = "tg-pill " + d.pillClass;
      document.querySelector("#sig-h span:last-child").textContent = d.word;
      document.getElementById("sig-inst").textContent = d.inst;
      document.getElementById("sig-price").textContent = d.price;
      document.getElementById("sig-tp1").textContent = d.tp1;
      document.getElementById("sig-tp2").textContent = d.tp2;
      document.getElementById("sig-sl").textContent = d.sl;
      // a breakout has no fixed take-profit — it rides the trend — so hide the TP rows
      var isBrk = key === "brk";
      document.getElementById("sig-row-tp1").hidden = isBrk;
      document.getElementById("sig-row-tp2").hidden = isBrk;
    }

    tabs.forEach(function(t, idx){
      t.addEventListener("click", function(){ setActive(t.dataset.set); });
      t.addEventListener("keydown", function(e){
        if(e.key === "ArrowRight" || e.key === "ArrowLeft"){
          e.preventDefault();
          var dir = e.key === "ArrowRight" ? 1 : -1;
          var next = (idx + dir + tabs.length) % tabs.length;
          tabs[next].focus();
          setActive(tabs[next].dataset.set);
        }
      });
    });

    /* ---------- gentle scroll reveal for the ported week section ---------- */
    (function(){
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var els = document.querySelectorAll('.reveal');
      if (reduce || !('IntersectionObserver' in window)) {
        els.forEach(function(el){ el.classList.add('in'); });
        return;
      }
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }
        });
      }, { threshold: 0.16, rootMargin: '0px 0px -8% 0px' });
      els.forEach(function(el){ io.observe(el); });
    })();

  })();
</script>
