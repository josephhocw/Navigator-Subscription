---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Render the page at 90% scale on desktop (guides read oversized at 100%). */
  compact?: boolean;
}
const {
  title = "RHO Navigator — There's always a trend, now you'll see it",
  description = 'A TradingView indicator that reads support, resistance and trend for you — and a private group that sends the buy and sell signals straight to your phone. Hong Kong, Singapore, US, Forex, Crypto & Metals.',
  compact = false,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/rho-navigator-logo-64.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class:list={{ compact }}>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // Partner referral capture — store ?ref=<partner> on any landing page
      // so the pricing section can attach it to checkout later.
      import { captureRef } from '../scripts/referral.ts';
      captureRef();

      // Nav background on scroll
      const nav = document.getElementById('nav');
      const onScroll = () => {
        if (!nav) return;
        nav.classList.toggle('scrolled', window.scrollY > 20);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Mobile menu toggle — the drawer is fully CSS-driven via the `open` class.
      // A scrim dims the page behind the open drawer; tapping it (or pressing
      // Escape) closes the menu, and the body scroll-locks while it's open.
      const toggle = document.getElementById('navToggle');
      const links = document.getElementById('navLinks');
      const scrim = document.getElementById('navScrim');
      const setMenu = (open: boolean) => {
        links?.classList.toggle('open', open);
        toggle?.classList.toggle('open', open);
        toggle?.setAttribute('aria-expanded', String(open));
        scrim?.classList.toggle('open', open);
        // lock <html> too — it's the scrolling element in standards mode,
        // so a body-only lock leaves the page scrollable behind the drawer
        document.documentElement.classList.toggle('menu-open', open);
        document.body.classList.toggle('menu-open', open);
      };
      toggle?.addEventListener('click', () => {
        setMenu(!links?.classList.contains('open'));
      });
      // Close the drawer after tapping a link inside it
      links?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a') && links.classList.contains('open')) {
          setMenu(false);
        }
      });
      scrim?.addEventListener('click', () => setMenu(false));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && links?.classList.contains('open')) setMenu(false);
      });

      // Showcase tabs
      document.querySelectorAll<HTMLElement>('.tab').forEach((tab) => {
        tab.addEventListener('click', () => {
          document.querySelectorAll('.tab').forEach((t) => t.classList.remove('on'));
          document.querySelectorAll('.pane').forEach((p) => p.classList.remove('on'));
          tab.classList.add('on');
          document.getElementById(tab.dataset.pane || '')?.classList.add('on');
        });
      });

    </script>
  </body>
</html>
