---
import { PLANS } from '../data/plans.ts';
import '../styles/pricing.css';

const cats = [
  { key: 'single', label: 'Single Market' },
  { key: 'combo', label: 'Combos' },
  { key: 'all', label: 'All Markets' },
] as const;
// Default view is the Standard price; the toggle reveals the lower Pepperstone price.
// Account opening goes via the Step 1 guide (which carries the referral link with
// our IB code), not the raw referral link — the audience needs the hand-holding.
const OPEN_ACCOUNT_GUIDE = '/guides/open-pepperstone-free-tradingview';
const JOSEPH_WHATSAPP = 'https://wa.me/6582007039';
---
<div class="pricing-wrap" data-mode="standard">
  <div class="price-toggle" role="group" aria-label="Price mode">
    <button class="pt-mode on" type="button" data-mode="standard">Standard</button>
    <button class="pt-mode" type="button" data-mode="pepperstone">Pepperstone Price<span class="pt-dot"> · </span><span class="pt-save">Pay Less</span></button>
  </div>

  <div class="ptabs">
    {cats.map((c, i) => (
      <button class={`ptab ${i === 0 ? 'on' : ''}`} type="button" data-cat={c.key}>{c.label}</button>
    ))}
  </div>

  {cats.map((c, i) => (
    <div class={`plans ${i === 0 ? 'on' : ''}`} data-cat={c.key}>
      {c.key === 'combo' && (
        <div class="combo-bonus">🎁 Every combo plan includes the <b>Singapore market FREE</b></div>
      )}
      {PLANS.filter((p) => p.tier === c.key).map((p) => (
        <div class={`plan ${p.code === 'ALL' ? 'featured' : ''}`}>
          {p.code === 'ALL' && <span class="best">Best value</span>}
          <div class="pname">{p.name}</div>
          <div class="pdesc">{p.desc}</div>
          <div class="was" data-show="pepperstone">${p.listMonthly}/mo</div>
          <div class="price">
            <span class="cur">$</span>
            <span class="amt" data-standard={String(p.listMonthly)} data-pepperstone={String(p.pepMonthly)}>{p.listMonthly}</span>
            <span class="punit"><span class="u1">SGD</span><span class="u2">/ month</span></span>
          </div>
          <div class="qtr">
            billed quarterly at
            <span data-standard={`$${p.listQuarterly} SGD`} data-pepperstone={`$${p.pepQuarterly} SGD`}>${p.listQuarterly} SGD</span>
          </div>
          {p.saveQuarterly && <div class="save">Save ${p.saveQuarterly} SGD / quarter</div>}
          <ul>
            {p.features.map((f) => <li><span class="ck">✓</span> {f === 'Singapore market FREE' ? <b>{f}</b> : f}</li>)}
          </ul>
          {/* A real link to the standard checkout, so the purchase path works
              even if JavaScript never loads. The script intercepts the click
              to route through the Pepperstone modals. */}
          <a class="btn btn-primary btn-block sub-btn" href={p.link} data-promo={p.promoCode} data-name={p.name} data-save={String(p.listQuarterly - p.pepQuarterly)}>Subscribe</a>
        </div>
      ))}
    </div>
  ))}

  <!-- Modal A: Pepperstone-mode confirm -->
  <div class="pep-modal" id="pepConfirm" hidden>
    <div class="pep-backdrop" data-close></div>
    <div class="pep-card" role="dialog" aria-modal="true" aria-labelledby="pepConfirmTitle">
      <button class="pep-x" type="button" aria-label="Close" data-close><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6 18 18M18 6 6 18"/></svg></button>
      <div class="pep-ey">Quick Check</div>
      <h3 id="pepConfirmTitle">Unlock the Pepperstone Price</h3>
      <p>This price is for clients who've <b>opened a Pepperstone account through our link</b>. That's the only requirement.</p>
      <p class="pep-fine">Funding the account and placing a trade aren't needed for this price — those unlock the separate free TradingView plan.</p>
      <div class="pep-btns">
        <a class="btn btn-primary btn-block" id="pepConfirmYes" href="#">Yes, I Have One — Continue</a>
        <a class="btn btn-ghost btn-block" id="pepOpen2" href={OPEN_ACCOUNT_GUIDE} target="_blank" rel="noopener">Not Yet — Open an Account</a>
      </div>
    </div>
  </div>

  <!-- Modal B: Standard-mode nudge. Two states: the offer (ask), then — after the
       referral link opens in a new tab — the return path (back), so the buyer never
       leaves the checkout flow. Opening the account is the only requirement for the
       lower price; funding/trading belong to the separate free-TradingView promo. -->
  <div class="pep-modal" id="pepNudge" hidden>
    <div class="pep-backdrop" data-close></div>
    <div class="pep-card" role="dialog" aria-modal="true" aria-labelledby="pepNudgeTitle">
      <button class="pep-x" type="button" aria-label="Close" data-close><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6 18 18M18 6 6 18"/></svg></button>
      <div class="pep-ey">Pay Less With Pepperstone</div>
      <h3 id="pepNudgeTitle">Want the Lower Price?</h3>

      <div id="pepNudgeAsk">
        <p>Open a Pepperstone account through our link and this plan costs <b>$<span id="pepSaveAmt">30</span> SGD less every quarter</b> — plus you get 3 months of TradingView free.</p>
        <p class="pep-fine">Opening the account is the only requirement for the lower price — no deposit or trade needed. Those come later, for the free TradingView plan. The button opens our step-by-step guide in a new tab.</p>
        <div class="pep-btns">
          <a class="btn btn-primary btn-block" id="pepOpen" href={OPEN_ACCOUNT_GUIDE} target="_blank" rel="noopener">Open a Pepperstone Account</a>
          <button class="btn btn-ghost btn-block" type="button" id="pepHave">I Have One — Show My Price</button>
          <button class="btn btn-ghost btn-block pep-decline" type="button" id="pepNo">No Thanks — Continue at Standard</button>
        </div>
      </div>

      <div id="pepNudgeBack" hidden>
        <p>Our step-by-step guide is open in a <b>new tab</b> — it walks you through opening your account, about 10 minutes. When you're done, come back to this tab and continue at your lower price.</p>
        <div class="pep-btns">
          <a class="btn btn-primary btn-block" id="pepBackGo" href="#">I've Opened My Account — Continue</a>
          <button class="btn btn-ghost btn-block pep-decline" type="button" id="pepNo2">Continue at Standard Instead</button>
        </div>
        <div class="pep-help">
          <span class="pep-help-q">Stuck anywhere? Message Joseph:</span>
          <span class="pep-help-links">
            <a href={JOSEPH_WHATSAPP} target="_blank" rel="noopener">WhatsApp 8200 7039</a>
            <span class="pep-help-sep" aria-hidden="true">·</span>
            <a href="https://t.me/Joseph_Ho" target="_blank" rel="noopener">Telegram @Joseph_Ho</a>
          </span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Wiring for the toggle, category tabs and the two Pepperstone modals.
  // Lives with the component so it works wherever <PriceToggle /> is rendered
  // (currently the homepage #pricing section).
  import { captureRef, decorateSubscribeLinks } from '../scripts/referral.ts';

  const wrap = document.querySelector<HTMLElement>('.pricing-wrap');
  if (wrap) {
    // Attach any stored partner ref to the checkout links before the click
    // handlers read them — all three paths (direct link, Pepperstone-confirm
    // modal, standard-mode redirect) start from the button's href.
    // captureRef first (idempotent): this component's script runs BEFORE
    // Base.astro's, so on a first landing with ?ref= the tag wouldn't be in
    // localStorage yet when we decorate.
    captureRef();
    decorateSubscribeLinks('.sub-btn');
    // --- price mode toggle ---
    const setMode = (mode: 'standard' | 'pepperstone') => {
      wrap.dataset.mode = mode;
      wrap.querySelectorAll<HTMLElement>('.pt-mode').forEach((b) =>
        b.classList.toggle('on', b.dataset.mode === mode),
      );
      wrap.querySelectorAll<HTMLElement>('[data-standard]').forEach((el) => {
        const next = el.dataset[mode];
        if (next != null) el.textContent = next;
      });
    };
    wrap.querySelectorAll<HTMLElement>('.pt-mode').forEach((b) =>
      b.addEventListener('click', () => setMode(b.dataset.mode === 'standard' ? 'standard' : 'pepperstone')),
    );
    // Landing with ?mode=pepperstone (e.g. from the Free TradingView page's
    // "Subscribe at the Pepperstone price" button) starts on the lower prices.
    if (new URLSearchParams(location.search).get('mode') === 'pepperstone') setMode('pepperstone');

    // --- category tabs (single / combo / all) ---
    wrap.querySelectorAll<HTMLElement>('.ptab').forEach((b) =>
      b.addEventListener('click', () => {
        wrap.querySelectorAll('.ptab').forEach((x) => x.classList.remove('on'));
        b.classList.add('on');
        wrap.querySelectorAll('.plans').forEach((p) => p.classList.remove('on'));
        wrap.querySelector(`.plans[data-cat="${b.dataset.cat}"]`)?.classList.add('on');
      }),
    );

    // --- modals ---
    const confirm = document.getElementById('pepConfirm');
    const confirmYes = document.getElementById('pepConfirmYes') as HTMLAnchorElement | null;
    const nudge = document.getElementById('pepNudge');
    // Open/close also toggle a body class that locks page scroll behind the
    // modal. Focus management: focus moves into the dialog on open, Tab cycles
    // inside it, and focus returns to the Subscribe button that opened it.
    let lastTrigger: HTMLElement | null = null;
    const open = (m: HTMLElement | null) => {
      if (!m) return;
      lastTrigger = document.activeElement as HTMLElement | null;
      m.removeAttribute('hidden');
      document.documentElement.classList.add('modal-open');
      document.body.classList.add('modal-open');
      m.querySelector<HTMLElement>('.pep-x')?.focus();
    };
    const close = (m: HTMLElement | null) => {
      if (!m || m.hasAttribute('hidden')) return;
      m.setAttribute('hidden', '');
      document.documentElement.classList.remove('modal-open');
      document.body.classList.remove('modal-open');
      lastTrigger?.focus();
      lastTrigger = null;
    };
    document.querySelectorAll<HTMLElement>('[data-close]').forEach((el) =>
      el.addEventListener('click', () => close(el.closest<HTMLElement>('.pep-modal'))),
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { close(confirm); close(nudge); }
      // Keep Tab inside the open dialog (wrap at both ends)
      if (e.key === 'Tab') {
        const m = [confirm, nudge].find((x) => x && !x.hasAttribute('hidden'));
        if (!m) return;
        // Exclude controls inside a hidden nudge state, or Tab escapes the dialog.
        const focusables = Array.from(
          m.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
        ).filter((el) => !el.closest('[hidden]'));
        if (!focusables.length) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        const active = document.activeElement;
        if (e.shiftKey && (active === first || !m.contains(active))) {
          last.focus(); e.preventDefault();
        } else if (!e.shiftKey && (active === last || !m.contains(active))) {
          first.focus(); e.preventDefault();
        }
      }
    });

    let pendingStandardLink = '';

    // The nudge's two states: the offer, and the come-back-and-continue path
    // shown once the account form is open in the other tab.
    const nudgeAsk = document.getElementById('pepNudgeAsk');
    const nudgeBack = document.getElementById('pepNudgeBack');
    const backGo = document.getElementById('pepBackGo') as HTMLAnchorElement | null;
    const setNudgeState = (state: 'ask' | 'back') => {
      if (!nudgeAsk || !nudgeBack) return;
      nudgeAsk.toggleAttribute('hidden', state !== 'ask');
      nudgeBack.toggleAttribute('hidden', state !== 'back');
    };

    // Checkout link with the plan's promo code prefilled. URL API rather than
    // string concat: the href may already carry ?client_reference_id=<partner
    // ref> from decorateSubscribeLinks.
    const discountedLink = (btn: HTMLAnchorElement) => {
      const url = new URL(btn.getAttribute('href')!);
      url.searchParams.set('prefilled_promo_code', btn.dataset.promo || '');
      return url.toString();
    };

    // "Open a Pepperstone Account" → the referral link opens in a new tab
    // (default anchor behaviour); this tab flips to the return path.
    document.getElementById('pepOpen')?.addEventListener('click', () => setNudgeState('back'));
    // Same from the confirm modal's "Not Yet — Open an Account": referral opens
    // in a new tab, and this tab swaps to the nudge's return path so the buyer
    // can continue at the lower price when they come back.
    document.getElementById('pepOpen2')?.addEventListener('click', () => {
      setNudgeState('back');
      close(confirm);
      open(nudge);
    });
    // "I have a Pepperstone account" → show the cheaper view
    document.getElementById('pepHave')?.addEventListener('click', () => { close(nudge); setMode('pepperstone'); });
    // "No thanks" (either state) → standard checkout
    const toStandard = () => {
      if (pendingStandardLink) window.location.href = pendingStandardLink;
    };
    document.getElementById('pepNo')?.addEventListener('click', toStandard);
    document.getElementById('pepNo2')?.addEventListener('click', toStandard);

    // --- subscribe ---
    // The buttons are plain links to the standard checkout (the no-JS path).
    // With JS running, intercept the click and route through the modals.
    wrap.querySelectorAll<HTMLAnchorElement>('.sub-btn').forEach((btn) =>
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        // Both modals can end at the nudge's return state, so the standard
        // fallback and the discounted continue link are set for either path.
        pendingStandardLink = btn.getAttribute('href')!;
        if (backGo) backGo.href = discountedLink(btn);
        if (wrap.dataset.mode === 'pepperstone') {
          if (confirmYes) confirmYes.href = discountedLink(btn);
          open(confirm);
        } else {
          const save = document.getElementById('pepSaveAmt');
          if (save && btn.dataset.save) save.textContent = btn.dataset.save;
          setNudgeState('ask');
          open(nudge);
        }
      }),
    );
  }
</script>
