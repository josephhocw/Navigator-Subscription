---
// The RHO Navigator logo — the approved compass mark (raster, from the design skill).
// Square tile art, so we round the corners slightly for inline use.
interface Props {
  size?: number;
  class?: string;
}
const { size = 30, class: className = '' } = Astro.props;
---
<img
  src="/rho-navigator-logo.png"
  width={size}
  height={size}
  alt="RHO Navigator"
  class={className}
  style="border-radius: 22%; display: block;"
/>
