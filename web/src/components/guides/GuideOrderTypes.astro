---
// Concept diagram for the "Learn to Trade" track (page 6): the three order types
// placed against one price line. A single vertical price axis runs through a
// dark well; the current price sits in the middle as a Market entry, a Limit buy
// waits below it, and a Stop sits above it. Each marker is a labelled chip with
// its own shape, so the three read apart by position and text, never colour
// alone. All wording is real HTML text at legible size. Static, so nothing to
// gate on prefers-reduced-motion.
//
// Geometry: y grows downward. Higher price = smaller y. The current price is the
// anchor; Stop sits above (smaller y), Limit below (larger y).
const CUR_Y = 110;   // current price line
const STOP_Y = 46;   // above current — a stop buy triggers on a move up
const LIMIT_Y = 174; // below current — a limit buy waits for a dip
const AXIS_X = 70;   // the price line's x
---
<figure class="got">
  <div class="got-card">
    <svg class="got-chart" viewBox="0 0 360 220" role="img"
      aria-label="One vertical price line. In the middle, a Market order buys now at the current price. Below it, a Limit order waits to buy lower. Above it, a Stop order triggers once the price rises past a set level.">
      <!-- the price line -->
      <line x1={AXIS_X} y1="20" x2={AXIS_X} y2="200" class="got-axis" />
      <text x={AXIS_X} y="14" class="got-axistop" text-anchor="middle">higher price</text>
      <text x={AXIS_X} y="214" class="got-axisbot" text-anchor="middle">lower price</text>

      <!-- Stop: above the current price -->
      <g class="got-mark got-stop">
        <line x1={AXIS_X} y1={STOP_Y} x2="120" y2={STOP_Y} class="got-lead" />
        <circle cx={AXIS_X} cy={STOP_Y} r="5" class="got-dot" />
        <rect x="120" y={STOP_Y - 15} width="222" height="30" rx="6" class="got-chip" />
        <text x="132" y={STOP_Y + 5} textLength="198" lengthAdjust="spacingAndGlyphs" class="got-chip-text">Stop &mdash; triggers once price rises past here</text>
      </g>

      <!-- Market: at the current price -->
      <g class="got-mark got-market">
        <line x1={AXIS_X} y1={CUR_Y} x2="120" y2={CUR_Y} class="got-lead got-lead-now" />
        <circle cx={AXIS_X} cy={CUR_Y} r="6" class="got-dot got-dot-now" />
        <rect x="120" y={CUR_Y - 15} width="222" height="30" rx="6" class="got-chip got-chip-now" />
        <text x="132" y={CUR_Y + 5} textLength="198" lengthAdjust="spacingAndGlyphs" class="got-chip-text got-chip-text-now">Market &mdash; buys now, at the current price</text>
      </g>

      <!-- Limit: below the current price -->
      <g class="got-mark got-limit">
        <line x1={AXIS_X} y1={LIMIT_Y} x2="120" y2={LIMIT_Y} class="got-lead" />
        <circle cx={AXIS_X} cy={LIMIT_Y} r="5" class="got-dot" />
        <rect x="120" y={LIMIT_Y - 15} width="222" height="30" rx="6" class="got-chip" />
        <text x="132" y={LIMIT_Y + 5} textLength="198" lengthAdjust="spacingAndGlyphs" class="got-chip-text">Limit &mdash; waits to buy lower, at your price</text>
      </g>
    </svg>

    <p class="got-note">
      <strong>Market</strong> deals straightaway. <strong>Limit</strong> and <strong>Stop</strong> sit and wait for the price to reach a level you choose.
    </p>
  </div>
  <figcaption class="got-foot">One price line, three ways in. The example shows a buy; selling works the same in reverse.</figcaption>
</figure>

<style>
  .got { margin: var(--space-6) 0; }
  .got-card {
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-5) var(--space-5) var(--space-4);
  }
  .got-chart { width: 100%; height: auto; display: block; }

  .got-axis { stroke: var(--line-strong); stroke-width: 2; }
  .got-axistop, .got-axisbot {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    fill: var(--muted);
  }

  .got-lead { stroke: var(--line-strong); stroke-width: 1.5; stroke-dasharray: 3 3; }
  .got-lead-now { stroke: var(--cyan); stroke-dasharray: none; }

  .got-dot { fill: var(--surface); stroke: var(--muted); stroke-width: 2; }
  .got-dot-now { fill: var(--cyan); stroke: var(--cyan-light); }

  .got-chip { fill: var(--surface); stroke: var(--line-strong); stroke-width: 1; }
  .got-chip-now { fill: var(--surface); stroke: var(--cyan); stroke-width: 1.5; }

  .got-chip-text {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    fill: var(--text);
  }
  .got-chip-text-now { fill: var(--ink); font-weight: 700; }

  .got-note {
    color: var(--text);
    font-size: 1rem;
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
  }
  .got-note strong { color: var(--cyan-light); font-weight: 700; }

  .got-foot {
    text-align: center;
    color: var(--muted);
    margin-top: var(--space-3);
    font-size: 0.95rem;
  }
</style>
