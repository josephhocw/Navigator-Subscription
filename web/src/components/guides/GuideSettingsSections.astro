---
// The settings window (Inputs tab) beside a card per section — what each group
// of options controls, without walking through every checkbox. Each card
// carries its own accent colour (underlined header + left edge + faint tint)
// so the four cards read apart at a glance. The cards column stretches to the
// figure's height and space-between distributes the four cards down it, so
// the column top-aligns with the screenshot and each card lands roughly
// beside its section at any width (absolute pinning was tried and overlaps:
// the cards are taller than the gaps between the dialog's section headers).
// strip = the section's vertical range inside the screenshot (top/height as %
// of the image), drawn as a colour-matched marker on the image's left edge.
// Strips measured on the October 2026 trimmed window (462 x 692). If the
// screenshot is missing, a placeholder frame holds the slot and no strips draw.
import fs from 'node:fs';
import path from 'node:path';
const shot = '/learn/understanding/settings-dialog.png';
const hasShot = fs.existsSync(path.join(process.cwd(), 'public', shot.replace(/^\//, '')));
// Row template for the cards column: alternating gap / section rows in the
// same proportions as the strips, so card N starts level with section N. The
// column is stretched to the image height and every row is minmax(0, fr), so
// a card that is taller than its section overflows into the gap below it
// instead of pushing the column past the image.
const sections = [
  {
    name: 'UI Panels',
    text: 'Show or hide the two info panels, Trend Analysis at the top and Channel Levels at the bottom. Handy on the phone.',
    color: '#38bdf8',
    tint: 'rgba(56, 189, 248, 0.07)',
    strip: { top: '17.3%', height: '12.3%' },
  },
  {
    name: 'UI Labels',
    text: 'Show or hide each label family: the support and resistance hits, the buy and sell signals, the breakout and acceleration labels, and the middle-line dots. Label Size picks how big they print.',
    color: '#8b5cf6',
    tint: 'rgba(139, 92, 246, 0.07)',
    strip: { top: '34.7%', height: '27.7%' },
  },
  {
    name: 'Moving Averages',
    text: 'Show or hide the MA 5, the orange line.',
    color: '#f59e0b',
    tint: 'rgba(245, 158, 11, 0.07)',
    strip: { top: '67.3%', height: '8.5%' },
  },
  {
    name: 'Chart Lines',
    text: 'One toggle, Show SL Lines: the stop-loss lines beyond the channel and the extended lines. Off by default.',
    color: '#12b98d',
    tint: 'rgba(18, 185, 141, 0.07)',
    strip: { top: '80.3%', height: '8.5%' },
  },
];
const pct = (v) => parseFloat(v);
const rowParts = [];
let cursor = 0;
for (const s of sections) {
  const t = pct(s.strip.top), h = pct(s.strip.height);
  rowParts.push(`minmax(0, ${(t - cursor).toFixed(1)}fr)`, `minmax(0, ${h.toFixed(1)}fr)`);
  cursor = t + h;
}
rowParts.push(`minmax(0, ${(100 - cursor).toFixed(1)}fr)`);
const rowTemplate = rowParts.join(' ');
---
<figure class="gset">
    <span class="gset-canvas">
      {hasShot ? (
        <>
          <img src={shot} alt="The Navigator settings window, Inputs tab" loading="lazy" />
          {sections.map((s) => (
            <span class="gset-strip" style={`--ac:${s.color};top:${s.strip.top};height:${s.strip.height}`} aria-hidden="true"></span>
          ))}
        </>
      ) : (
        <span class="gset-ph">
          <span class="gset-ph-code">Settings window</span>
          <span class="gset-ph-note">Screenshot coming soon</span>
        </span>
      )}
    </span>
  <div class="gset-cardwrap">
  <div class="gset-cards" style={`--rows:${rowTemplate}`}>
    {sections.map((s, i) => (
      <article class="gset-card" style={`--ac:${s.color};--ac-tint:${s.tint};grid-row:${2 * i + 2}`}>
        <p class="gset-name">{s.name}</p>
        <p class="gset-text">{s.text}</p>
      </article>
    ))}
  </div>
  </div>
  <figcaption class="gset-cap">The Inputs tab of the settings window.</figcaption>
</figure>

<style>
  .gset {
    display: grid;
    grid-template-columns: minmax(0, 48%) minmax(0, 1fr);
    column-gap: 24px;
    row-gap: 0;
    align-items: stretch;
    margin: 22px 0;
  }

  .gset-canvas { position: relative; display: block; grid-column: 1; grid-row: 1; }
  .gset-canvas img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 12px;
    border: 1px solid var(--line);
  }
  /* Colour-matched section markers on the screenshot's left edge — each strip
     spans its section's rows and echoes the matching card's accent colour. */
  .gset-strip {
    position: absolute;
    left: -3px;
    width: 6px;
    border-radius: 3px;
    background: var(--ac);
    box-shadow: 0 0 10px var(--ac);
  }
  .gset-cap { grid-column: 1 / -1; grid-row: 2; color: var(--muted); font-size: 0.85rem; margin-top: 0.55rem; }
  /* Placeholder shown until the screenshot is dropped in */
  .gset-ph {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    aspect-ratio: 2 / 3;
    width: 100%;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--surface-2);
  }
  .gset-ph-code { font-weight: 800; font-size: 1.2rem; color: var(--ink); }
  .gset-ph-note { color: var(--muted); font-size: 0.9rem; }

  /* The cards column is exactly the image's height (same grid row, stretched)
     and its rows mirror the strips (see the frontmatter), so each card's top
     edge lines up with its section marker. */
  /* The wrapper sits in the image's grid row and contributes no height of its
     own (the cards grid is absolutely positioned inside it), so the row is
     exactly as tall as the image and the fr rows share that definite height. */
  .gset-cardwrap { grid-column: 2; grid-row: 1; position: relative; min-height: 0; }
  .gset-cards {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: var(--rows);
  }
  .gset-card {
    align-self: start;
    min-height: 0;
    border: 1px solid var(--line);
    border-left: 3px solid var(--ac);
    border-radius: var(--radius);
    background: linear-gradient(var(--ac-tint), var(--ac-tint)), var(--surface);
    padding: 8px 12px;
  }
  .gset-name {
    margin: 0 0 5px;
    padding-bottom: 4px;
    border-bottom: 2px solid var(--ac);
    color: var(--ink);
    font-weight: 700;
    font-size: 0.95rem;
  }
  .gset-text { margin: 0; color: var(--text); font-size: 0.86rem; line-height: 1.38; }

  @media (max-width: 700px) {
    .gset { grid-template-columns: 1fr; }
    .gset-canvas { grid-column: 1; grid-row: 1; }
    .gset-cardwrap { grid-column: 1; grid-row: 2; }
    .gset-cards { position: static; display: flex; flex-direction: column; gap: 10px; margin-top: 12px; }
    .gset-cap { grid-row: 3; }
  }
</style>
