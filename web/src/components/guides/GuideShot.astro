---
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  /** Path under public/, e.g. "/guides/step-1/claim-a-plan.png" */
  src: string;
  /** Shown under the image (and inside the placeholder while it's empty) */
  caption: string;
  /** Alt text for the real screenshot; falls back to the caption */
  alt?: string;
  /** Tall portrait screenshots (forms, phone shots): cap the displayed size and centre it */
  narrow?: boolean;
  /** Per-image override of the narrow height cap, e.g. "480px" (implies narrow) */
  maxHeight?: string;
  /** Numbered pins overlaid on the screenshot, positioned as % of the image.
   *  `top` is required; `left` defaults to the left edge. Pair with a matching
   *  numbered list so each pin tags a part of the image. */
  pins?: Array<{ n: number; top: string; left?: string }>;
  /** Scale just this one shot, overriding the guide's page-level shotScale.
   *  e.g. 0.82 = 18% smaller. Applied via the same --shot-scale zoom. */
  scale?: number;
  /** Cap the caption's width (e.g. "220px") so it wraps under a narrow shot
   *  instead of running the full column. */
  capWidth?: string;
}
const { src, caption, alt = caption, maxHeight, pins, narrow = Boolean(maxHeight), scale, capWidth } = Astro.props;

// Build-time check: if the screenshot has been dropped into public/ it renders
// for real; until then a visible placeholder frame holds the slot and shows the
// exact filename to save. Swapping in = save the file + redeploy, no code edit.
// Resolved from the project root (process.cwd()), not import.meta.url — the
// latter points at the compiled chunk during `astro build`, not this source file.
const publicDir = path.join(process.cwd(), 'public');
const exists = fs.existsSync(path.join(publicDir, src.replace(/^\//, '')));
---
{exists ? (
  <figure class:list={['gshot', { 'gshot-narrow': narrow, 'gshot-pinned': pins }]} style={scale ? `--shot-scale: ${scale}` : undefined}>
    <button class="gshot-zoombtn" type="button" data-gshot-zoom={src} data-gshot-alt={alt} aria-label={`Enlarge screenshot: ${alt}`}>
      {pins ? (
        <span class="gshot-canvas">
          <img src={src} alt={alt} loading="lazy" style={maxHeight ? `max-height:${maxHeight}` : undefined} />
          {pins.map((p) => (
            <span class="gshot-pin" style={`top:${p.top};left:${p.left ?? '0%'}`} aria-hidden="true">{p.n}</span>
          ))}
        </span>
      ) : (
        <img src={src} alt={alt} loading="lazy" style={maxHeight ? `max-height:${maxHeight}` : undefined} />
      )}
      <span class="gshot-zoomhint" aria-hidden="true">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path><path d="M11 8v6M8 11h6"></path></svg>
        Tap to enlarge
      </span>
    </button>
    {caption && <figcaption style={capWidth ? `max-width:${capWidth}` : undefined}>{caption}</figcaption>}
  </figure>
) : (
  <figure class="gshot gshot-empty">
    <div class="gshot-frame">
      <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
        <circle cx="8.5" cy="8.5" r="1.5"></circle>
        <path d="m21 15-5-5L5 21"></path>
      </svg>
      <span class="gshot-soon">Screenshot coming soon</span>
      <code>{src}</code>
    </div>
    {caption && <figcaption>{caption}</figcaption>}
  </figure>
)}

<script>
  // Tap-to-enlarge: one shared lightbox <dialog> for every screenshot on the
  // page (Astro hoists and dedupes this script). The enlarged image shows at
  // its natural resolution inside a scrollable pane, so phone users can pan
  // around a big chart instead of squinting at a 360px-wide version.
  // Tap anywhere (or Esc) to close.
  function ensureLightbox(): HTMLDialogElement {
    let d = document.getElementById('gshot-lightbox') as HTMLDialogElement | null;
    if (!d) {
      d = document.createElement('dialog');
      d.id = 'gshot-lightbox';
      d.className = 'gshot-lb';
      d.innerHTML =
        '<div class="gshot-lb-scroll"><img alt="" /></div>' +
        '<button class="gshot-lb-close" type="button" aria-label="Close">✕</button>' +
        '<p class="gshot-lb-hint">Scroll to look around · tap to close</p>';
      d.addEventListener('click', () => d!.close());
      document.body.appendChild(d);
    }
    return d;
  }

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-gshot-zoom]');
    if (!btn) return;
    const d = ensureLightbox();
    const img = d.querySelector('img')!;
    img.src = btn.dataset.gshotZoom!;
    img.alt = btn.dataset.gshotAlt || '';
    d.showModal();
  });
</script>
