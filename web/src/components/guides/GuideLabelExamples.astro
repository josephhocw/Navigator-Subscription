---
// Toggle viewer for the chart labels. Pick a label group and see how it prints
// on a real chart, with what triggers it explained beside the image. CSS-only
// (hidden radios + labels), so it works without JavaScript and supports native
// arrow-key switching between groups.
//
// Groups: Resistance / Support (the hits — one annotated overview each), Buy /
// Sell (three signal cards each; B/S/EB/ES carry numbered steps for the
// three-bar confirmation that replaced the 50% entry level in October 2026,
// and their screenshots mark the three bars B1-B3 / B1-B3 to match), UTA, DTA
// (the two trend-acceleration markers, one each), New channel (NC).
// Chip/dot colours match the colours the labels print in on the chart.
const C = {
  resistance: '#9c1f5e',
  support: '#12997a',
  buy: '#2f6df0',
  sell: '#ee4452',
  uta: '#1397b0',
  dta: '#8b3fb0',
  nc: '#767676',
};

const families = [
  {
    key: 'r', name: 'Resistance', dot: C.resistance,
    cards: [
      {
        heading: 'Resistance hits', tone: C.resistance, wide: true,
        img: '/learn/labels/resistance.png',
        body: "Two labels mark the resistance side: R prints when price reaches the resistance line, ER when it reaches the extended resistance line above it. A maroon dot marks middle resistance on the middle line. A hit only marks price reaching a level — it's not an entry.",
      },
    ],
  },
  {
    key: 's', name: 'Support', dot: C.support,
    cards: [
      {
        heading: 'Support hits', tone: C.support, wide: true,
        img: '/learn/labels/support.png',
        body: "Two labels mark the support side: S prints when price reaches the support line, ES when it reaches the extended support line below it. A green dot marks middle support on the middle line. Like the resistance hits, these are not entries on their own.",
      },
    ],
  },
  {
    key: 'b', name: 'Buy', dot: C.buy,
    cards: [
      {
        code: 'B', name: 'Buy', dir: 'up', chip: C.buy,
        img: '/learn/labels/buy.png',
        steps: [
          'Price hits support (the S label).',
          'Three bars in a row (B1, B2, B3) close above the orange MA 5. B2 and B3 also close above support; B1 may close below it.',
          'One of them pushes past the bar before it: B2 closes above B1\'s high, or B3 above B2\'s high.',
          'On B3 the MA 5 is sloping up.',
          'B prints on B3 at its close. That close is the entry.',
        ],
      },
      {
        code: 'EB', name: 'Extended buy', dir: 'up', chip: C.buy,
        img: '/learn/labels/extended-buy.png',
        steps: [
          'Price hits the extended support line for the second time (the ES2 label).',
          'Three bars in a row (B1, B2, B3) close above the orange MA 5. B2 and B3 also close above extended support.',
          'One of them pushes past the bar before it: B2 closes above B1\'s high, or B3 above B2\'s high.',
          'On B3 the MA 5 is sloping up.',
          'EB prints on B3 at its close, unless that close is too close to the support line.',
        ],
      },
      {
        code: 'DTB', name: 'Downtrend breakout', dir: 'up', chip: C.buy,
        img: '/learn/strategies/buy-3-downtrend-breakout.png',
        body: 'A different trigger — price breaks out above a downtrend. It follows through about half the time, so keep the losses small and let the winners run.',
      },
    ],
  },
  {
    key: 'x', name: 'Sell', dot: C.sell,
    cards: [
      {
        code: 'S', name: 'Sell', dir: 'down', chip: C.sell,
        img: '/learn/labels/sell.png',
        steps: [
          'Price hits resistance (the R label).',
          'Three bars in a row (B1, B2, B3) close below the orange MA 5. B2 and B3 also close below resistance; B1 may close above it.',
          'One of them pushes past the bar before it: B2 closes below B1\'s low, or B3 below B2\'s low.',
          'On B3 the MA 5 is sloping down.',
          'S prints on B3 at its close. That close is the entry.',
        ],
      },
      {
        code: 'ES', name: 'Extended sell', dir: 'down', chip: C.sell,
        img: '/learn/labels/extended-sell.png',
        steps: [
          'Price hits the extended resistance line for the second time (the ER2 label).',
          'Three bars in a row (B1, B2, B3) close below the orange MA 5. B2 and B3 also close below extended resistance.',
          'One of them pushes past the bar before it: B2 closes below B1\'s low, or B3 below B2\'s low.',
          'On B3 the MA 5 is sloping down.',
          'ES prints on B3 at its close, unless that close is too close to the resistance line.',
        ],
      },
      {
        code: 'UTB', name: 'Uptrend breakdown', dir: 'down', chip: C.sell,
        img: '/learn/labels/uptrend-breakdown.png',
        body: 'A different trigger — price breaks down below an uptrend. It follows through about half the time.',
      },
    ],
  },
  {
    key: 'u', name: 'UTA', dot: C.uta,
    cards: [
      {
        code: 'UTA', name: 'Uptrend accelerates', dir: 'up', chip: C.uta,
        img: '/learn/labels/uptrend-accelerates.png',
        body: "Marks the uptrend picking up speed. It's not an entry on its own — it tells you the up move is getting stronger.",
      },
    ],
  },
  {
    key: 'd', name: 'DTA', dot: C.dta,
    cards: [
      {
        code: 'DTA', name: 'Downtrend accelerates', dir: 'down', chip: C.dta,
        img: '/learn/labels/downtrend-accelerates.png',
        body: 'Marks the downtrend picking up speed — the down move is getting stronger.',
      },
    ],
  },
  {
    key: 'n', name: 'New channel', dot: C.nc,
    cards: [
      {
        code: 'NC', name: 'New channel', chip: C.nc,
        img: '/learn/labels/new-channel.png',
        body: 'NC marks the bar where the current channel formed. Before that bar, the previous channel was still in force. The section below shows how to look back at it.',
      },
    ],
  },
];

const arrowChar = (dir) => (dir === 'up' ? '▲' : '▼');
---
<div class="glex">
  {families.map((f, i) => (
    <input class="glex-radio" type="radio" name="glex-fam" id={`glex-${f.key}`} checked={i === 0} />
  ))}

  <div class="glex-tabs" role="group" aria-label="Choose a label group">
    {families.map((f) => (
      <label class="glex-tab" for={`glex-${f.key}`}>
        <span class="glex-tabdot" style={`--dot:${f.dot}`}></span>{f.name}
      </label>
    ))}
  </div>

  <div class="glex-stage">
    {families.map((f) => (
      <div class="glex-panel">
        <div class="glex-cards">
          {f.cards.map((c) => (
            <article class:list={['glex-card', { 'glex-card--wide': c.wide }]}>
              <figure class="glex-media">
                {c.img ? (
                  <img src={c.img} alt={`${c.code || c.name || c.heading} on a chart`} loading="lazy" />
                ) : (
                  <div class="glex-ph" style={`--c:${c.chip || c.tone}`}>
                    <span class="glex-ph-code">{c.code || c.heading}</span>
                    <span class="glex-ph-note">Chart example coming soon</span>
                  </div>
                )}
              </figure>
              <div class="glex-body">
                <div class="glex-head">
                  {c.code ? (
                    <span class="glex-chip" style={`background:${c.chip}`}>{c.code}</span>
                  ) : (
                    <span class="glex-swatch" style={`background:${c.tone}`}></span>
                  )}
                  <span class="glex-name">
                    {c.name || c.heading}
                    {c.dir && <span class="glex-dir" aria-hidden="true">{arrowChar(c.dir)}</span>}
                  </span>
                </div>
                {c.steps ? (
                  <ol class="glex-steps">
                    {c.steps.map((st) => <li>{st}</li>)}
                  </ol>
                ) : (
                  <p class="glex-text">{c.body}</p>
                )}
                {c.note && <p class="glex-note">{c.note}</p>}
              </div>
            </article>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .glex { position: relative; margin: 22px 0; }

  /* Hidden but focusable (native radio group: arrow keys switch groups) */
  .glex-radio {
    position: absolute;
    width: 1px; height: 1px;
    margin: -1px; padding: 0; border: 0;
    clip: rect(0 0 0 0);
    overflow: hidden; white-space: nowrap;
  }

  .glex-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 16px;
  }
  .glex-tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 46px;
    padding: 10px 14px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font-weight: 600;
    font-size: 1.02rem;
    cursor: pointer;
    user-select: none;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
  }
  .glex-tab:hover { border-color: var(--cyan); color: var(--ink); }
  .glex-tabdot { width: 13px; height: 13px; border-radius: 4px; flex: none; background: var(--dot); transition: background 0.15s ease; }

  /* Active tab — filled with its group colour plus a soft glow in the same
     colour (the homepage tab treatment, tinted per family). The dot goes
     near-white instead of disappearing, so the label doesn't shift. */
  #glex-r:checked ~ .glex-tabs label[for="glex-r"] { background: #9c1f5e; border-color: #9c1f5e; color: #fff; font-weight: 700; box-shadow: 0 8px 22px -8px #9c1f5e; }
  #glex-s:checked ~ .glex-tabs label[for="glex-s"] { background: #12997a; border-color: #12997a; color: #fff; font-weight: 700; box-shadow: 0 8px 22px -8px #12997a; }
  #glex-b:checked ~ .glex-tabs label[for="glex-b"] { background: #2f6df0; border-color: #2f6df0; color: #fff; font-weight: 700; box-shadow: 0 8px 22px -8px #2f6df0; }
  #glex-x:checked ~ .glex-tabs label[for="glex-x"] { background: #ee4452; border-color: #ee4452; color: #fff; font-weight: 700; box-shadow: 0 8px 22px -8px #ee4452; }
  #glex-u:checked ~ .glex-tabs label[for="glex-u"] { background: #1397b0; border-color: #1397b0; color: #fff; font-weight: 700; box-shadow: 0 8px 22px -8px #1397b0; }
  #glex-d:checked ~ .glex-tabs label[for="glex-d"] { background: #8b3fb0; border-color: #8b3fb0; color: #fff; font-weight: 700; box-shadow: 0 8px 22px -8px #8b3fb0; }
  #glex-n:checked ~ .glex-tabs label[for="glex-n"] { background: #767676; border-color: #767676; color: #fff; font-weight: 700; box-shadow: 0 8px 22px -8px #767676; }

  #glex-r:checked ~ .glex-tabs label[for="glex-r"] .glex-tabdot,
  #glex-s:checked ~ .glex-tabs label[for="glex-s"] .glex-tabdot,
  #glex-b:checked ~ .glex-tabs label[for="glex-b"] .glex-tabdot,
  #glex-x:checked ~ .glex-tabs label[for="glex-x"] .glex-tabdot,
  #glex-u:checked ~ .glex-tabs label[for="glex-u"] .glex-tabdot,
  #glex-d:checked ~ .glex-tabs label[for="glex-d"] .glex-tabdot,
  #glex-n:checked ~ .glex-tabs label[for="glex-n"] .glex-tabdot { background: #fff; }

  /* Focus ring on the active tab when navigating by keyboard */
  #glex-r:focus-visible ~ .glex-tabs label[for="glex-r"],
  #glex-s:focus-visible ~ .glex-tabs label[for="glex-s"],
  #glex-b:focus-visible ~ .glex-tabs label[for="glex-b"],
  #glex-x:focus-visible ~ .glex-tabs label[for="glex-x"],
  #glex-u:focus-visible ~ .glex-tabs label[for="glex-u"],
  #glex-d:focus-visible ~ .glex-tabs label[for="glex-d"],
  #glex-n:focus-visible ~ .glex-tabs label[for="glex-n"] {
    outline: 2px solid var(--cyan-light, #38bdf8);
    outline-offset: 2px;
  }

  /* Panels — show only the checked group's */
  .glex-panel { display: none; }
  #glex-r:checked ~ .glex-stage .glex-panel:nth-child(1),
  #glex-s:checked ~ .glex-stage .glex-panel:nth-child(2),
  #glex-b:checked ~ .glex-stage .glex-panel:nth-child(3),
  #glex-x:checked ~ .glex-stage .glex-panel:nth-child(4),
  #glex-u:checked ~ .glex-stage .glex-panel:nth-child(5),
  #glex-d:checked ~ .glex-stage .glex-panel:nth-child(6),
  #glex-n:checked ~ .glex-stage .glex-panel:nth-child(7) { display: block; }

  /* Soft crossfade when a group switches (static under reduced motion) */
  @media (prefers-reduced-motion: no-preference) {
    .glex-panel { animation: glex-fade 0.18s ease; }
    @keyframes glex-fade { from { opacity: 0; } to { opacity: 1; } }
  }

  .glex-cards { display: flex; flex-direction: column; gap: 12px; }

  .glex-card {
    display: grid;
    grid-template-columns: minmax(0, 46%) minmax(0, 1fr);
    align-items: stretch;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
  }
  .glex-card--wide { grid-template-columns: 1fr; }

  .glex-media {
    display: flex;
    margin: 0;
    background: var(--surface-2);
    border-right: 1px solid var(--line);
  }
  .glex-card--wide .glex-media {
    border-right: none;
    border-bottom: 1px solid var(--line);
  }
  .glex-media img { display: block; width: 100%; height: auto; align-self: center; }

  .glex-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 9px;
    padding: 16px 18px;
  }
  .glex-head { display: flex; align-items: center; gap: 10px; }
  .glex-chip {
    display: inline-block;
    padding: 3px 9px;
    border-radius: 6px;
    color: #fff;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    flex: none;
  }
  .glex-swatch { width: 16px; height: 16px; border-radius: 4px; flex: none; }
  .glex-name { font-size: 1.05rem; font-weight: 700; color: var(--ink); }
  .glex-dir { margin-left: 5px; font-size: 0.78em; color: var(--muted); }
  .glex-text {
    margin: 0;
    color: var(--text);
    font-size: 1rem;
    line-height: 1.5;
  }

  /* Numbered steps on the signal cards — the same 1-2-3 discs as the chart */
  .glex-steps {
    list-style: none;
    counter-reset: glex-step;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .glex-steps li {
    counter-increment: glex-step;
    position: relative;
    margin: 0;
    padding-left: 34px;
    color: var(--text);
    font-size: 0.97rem;
    line-height: 1.45;
  }
  .glex-steps li::before {
    content: counter(glex-step);
    position: absolute;
    left: 0;
    top: 1px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #2f6df0;
    color: #fff;
    font-weight: 700;
    font-size: 0.82rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .glex-note {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  /* Placeholder shown until a real screenshot is dropped in */
  .glex-ph {
    flex: 1;
    aspect-ratio: 4 / 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    border-bottom: 3px solid var(--c);
  }
  .glex-ph-code { font-weight: 800; font-size: 1.2rem; color: var(--ink); }
  .glex-ph-note { color: var(--muted); font-size: 0.9rem; }

  @media (max-width: 640px) {
    .glex-card { grid-template-columns: 1fr; }
    .glex-media { border-right: none; border-bottom: 1px solid var(--line); }
  }
</style>
