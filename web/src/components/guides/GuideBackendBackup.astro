---
// Concept diagram for the "Learn to Trade" track (page 8): the backend is your
// backup — a second, independent way in to the same live trades. Two doors
// (TradingView and your backend) both open onto the one set of open positions,
// so if one is down, the other still reaches them. Meaning is carried by the
// labels and the shared-target arrows, not colour. Static, so nothing to gate on
// prefers-reduced-motion.
const ways = [
  {
    name: 'TradingView',
    note: 'where you trade day to day',
    tag: 'Your usual way in',
  },
  {
    name: 'Your backend',
    note: 'the broker platform behind it',
    tag: 'Your backup way in',
  },
];
---
<figure class="gbk">
  <div class="gbk-ways">
    {ways.map((w) => (
      <div class="gbk-card">
        <span class="gbk-tag">{w.tag}</span>
        <p class="gbk-name">{w.name}</p>
        <p class="gbk-note">{w.note}</p>
        <svg class="gbk-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="12" y1="3" x2="12" y2="21"></line>
          <polyline points="6 15 12 21 18 15"></polyline>
        </svg>
      </div>
    ))}
  </div>
  <div class="gbk-target">
    <p class="gbk-target-name">Your live trades</p>
    <p class="gbk-target-note">one set of open positions — both ways reach them</p>
  </div>
  <figcaption class="gbk-foot">Two separate ways in to the same trades. If one is ever down, the other still gets you to your positions.</figcaption>
</figure>

<style>
  .gbk { margin: var(--space-6) 0; }
  .gbk-ways {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }
  .gbk-card {
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-4);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .gbk-tag {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--cyan-light);
  }
  .gbk-name {
    font-weight: 700;
    color: var(--ink);
    font-size: 1.1rem;
    margin-top: var(--space-2);
  }
  .gbk-note { color: var(--muted); font-size: 0.95rem; margin-top: 2px; }
  .gbk-arrow {
    width: 22px;
    height: 22px;
    color: var(--cyan);
    margin-top: var(--space-3);
  }
  .gbk-target {
    background: var(--surface-2);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    padding: var(--space-4);
    text-align: center;
    margin-top: var(--space-3);
  }
  .gbk-target-name {
    font-weight: 700;
    color: var(--cyan-light);
    font-size: 1.05rem;
  }
  .gbk-target-note { color: var(--muted); font-size: 0.95rem; margin-top: 2px; }
  .gbk-foot {
    text-align: center;
    color: var(--muted);
    margin-top: var(--space-4);
    font-size: 0.95rem;
  }
  @media (max-width: 560px) {
    .gbk-ways { grid-template-columns: 1fr; }
  }
</style>
