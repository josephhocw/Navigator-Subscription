---
// Concept diagram for the "Learn to Trade" track (page 5): the idea that one
// specification / information panel holds every number for an instrument — its
// leverage (margin), contract size, spread, swap and commission all in one
// place, so it's a single lookup. Drawn as a labelled "panel" card listing the
// five fields, with a short note on what each one tells you. Meaning is carried
// by the text labels, not colour. Numbers are illustrative and flagged in the
// page copy. Static, so nothing to gate on prefers-reduced-motion.

// Illustrative fields, in the order they tend to appear on a spec panel.
const fields = [
  { name: 'Leverage / margin', note: 'how much of your own money is held to open the trade' },
  { name: 'Contract size', note: 'what one lot is worth in the market' },
  { name: 'Spread', note: 'the gap between buy and sell — the main cost' },
  { name: 'Swap', note: 'the small adjustment if you hold overnight' },
  { name: 'Commission', note: 'a small fee on forex and shares only' },
];
---
<figure class="gis">
  <div class="gis-card">
    <p class="gis-head">Instrument specification</p>
    <ul class="gis-list">
      {fields.map((f) => (
        <li class="gis-row">
          <span class="gis-name">{f.name}</span>
          <span class="gis-note">{f.note}</span>
        </li>
      ))}
    </ul>
  </div>
  <figcaption class="gis-foot">Every number for one instrument sits on a single panel, so it's one lookup, not five.</figcaption>
</figure>

<style>
  .gis { margin: var(--space-6) 0; }
  .gis-card {
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-5);
    max-width: 460px;
    margin-inline: auto;
  }
  .gis-head {
    font-weight: 700;
    color: var(--ink);
    font-size: 1.05rem;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line-strong);
  }
  .gis-list { list-style: none; }
  .gis-row {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--line);
  }
  .gis-row:last-child { border-bottom: 0; padding-bottom: 0; }
  .gis-name {
    font-weight: 700;
    color: var(--cyan-light);
    font-size: 1rem;
  }
  .gis-note { color: var(--muted); font-size: 0.95rem; }
  .gis-foot {
    text-align: center;
    color: var(--muted);
    margin-top: var(--space-4);
    font-size: 0.95rem;
  }
</style>
