---
// Colour-coded reference for every Navigator label. The chip colours match the
// colours the labels actually print in on the chart, so subscribers recognise
// them. Built with divs, not a <table>: docs.css reflows every prose table
// into stacked cards on phones, which mangled this custom layout. Desktop
// shows a family tile centred against its group on the right; on phones the
// family becomes a coloured header bar above its rows.
const C = {
  resistance: '#9c1f5e',
  resistanceDark: '#6d1b4f',
  support: '#12997a',
  buy: '#2f6df0',
  sell: '#ee4452',
  uta: '#1397b0',
  dta: '#8b3fb0',
  nc: '#767676',
};

const groups = [
  {
    family: { name: 'Resistance', bg: C.resistance },
    rows: [
      { code: 'ER',  meaning: 'Extended resistance hit', bg: C.resistanceDark },
      { code: 'ER2', meaning: 'Second extended resistance, shifted out', bg: C.resistanceDark },
      { code: 'R',   meaning: 'Resistance hit', bg: C.resistance },
      { meaning: 'Middle resistance — a maroon dot on the middle line', dot: C.resistance },
    ],
  },
  {
    family: { name: 'Support', bg: C.support },
    rows: [
      { code: 'ES',  meaning: 'Extended support hit', bg: C.support },
      { code: 'ES2', meaning: 'Second extended support, shifted out', bg: C.support },
      { code: 'S',   meaning: 'Support hit', bg: C.support },
      { meaning: 'Middle support — a green dot on the middle line', dot: C.support },
    ],
  },
  {
    family: { name: 'Buy signal', bg: C.buy },
    rows: [
      { code: 'B',   meaning: 'Buy signal', bg: C.buy },
      { code: 'EB',  meaning: 'Extended buy signal', bg: C.buy },
      { code: 'DTB', meaning: 'Downtrend breakout — a buy cue', bg: C.buy },
    ],
  },
  {
    family: { name: 'Sell signal', bg: C.sell },
    rows: [
      { code: 'S',   meaning: 'Sell signal', bg: C.sell },
      { code: 'ES',  meaning: 'Extended sell signal', bg: C.sell },
      { code: 'UTB', meaning: 'Uptrend breakdown — a sell cue', bg: C.sell },
    ],
  },
  {
    family: null,
    rows: [
      { code: 'UTA', meaning: 'Uptrend accelerates', bg: C.uta },
      { code: 'DTA', meaning: 'Downtrend accelerates', bg: C.dta },
      { code: 'NC',  meaning: 'New channel formed', bg: C.nc },
    ],
  },
];
---
<div class="glabels">
  {groups.map((g) => (
    <section class="glab-group">
      {g.family && (
        <header class="glab-fambar" style={`background:${g.family.bg}`}>{g.family.name}</header>
      )}
      <div class="glab-rows">
        {g.rows.map((r) => (
          <div class="glab-row">
            <div class="glab-code">
              {r.bg ? (
                <span class="glab-chip" style={`background:${r.bg}`}>{r.code}</span>
              ) : (
                <span class="glab-dotcell"><span class="glab-dot" style={`background:${r.dot}`}></span></span>
              )}
            </div>
            <div class="glab-meaning">{r.meaning}</div>
          </div>
        ))}
      </div>
      <aside class:list={['glab-fam', { 'glab-fam--empty': !g.family }]}>
        {g.family && (
          <>
            <span class="glab-fam-swatch" style={`background:${g.family.bg}`}></span>
            <span class="glab-fam-name">{g.family.name}</span>
          </>
        )}
      </aside>
    </section>
  ))}
</div>

<style>
  .glabels {
    margin: 22px 0;
    max-width: 700px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .glab-group {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 140px;
  }
  .glab-group + .glab-group { border-top: 1px solid var(--line); }

  /* Mobile-only family header bar */
  .glab-fambar { display: none; }

  .glab-rows { display: flex; flex-direction: column; }
  .glab-row {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    background: var(--surface);
  }
  .glab-row + .glab-row { border-top: 1px solid var(--line); }

  .glab-code { display: flex; align-items: stretch; }
  .glab-chip {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 9px 6px;
    color: #fff;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.02em;
  }
  .glab-dotcell {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 9px 6px;
  }
  .glab-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex: none;
  }

  .glab-meaning {
    display: flex;
    align-items: center;
    padding: 10px 16px;
    color: var(--ink);
    font-size: 1.02rem;
    line-height: 1.4;
  }

  /* Family tile (right column), centred vertically against its group */
  .glab-fam {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 12px 14px;
    background: var(--surface);
    border-left: 1px solid var(--line);
    text-align: center;
  }
  .glab-fam-swatch {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    flex: none;
  }
  .glab-fam-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.2;
  }

  /* Phones: the family tile becomes a coloured header bar above its rows,
     and the meaning column gets the full remaining width. */
  @media (max-width: 600px) {
    .glab-group { display: block; }
    .glab-fam { display: none; }
    .glab-fambar {
      display: block;
      padding: 9px 16px;
      color: #fff;
      font-weight: 700;
      font-size: 0.98rem;
      letter-spacing: 0.01em;
    }
    .glab-row { grid-template-columns: 56px minmax(0, 1fr); }
    .glab-meaning { font-size: 1rem; padding: 10px 14px; }
  }
</style>
