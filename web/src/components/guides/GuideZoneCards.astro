---
// The SL lines, one card: image left, explanation right. One toggle (Show SL
// Lines) draws all four since the October 2026 trim, so one card covers them.
// Each row is chipped by line type and states the placement in plain words;
// the bar-height definition lives in the prose above the cards, not repeated
// here. (The entry lines went with the October 2026 signal-logic change; the
// component name stays.) Until the new screenshots are dropped into public/,
// a placeholder frame holds each card's image slot.
import fs from 'node:fs';
import path from 'node:path';
const publicDir = path.join(process.cwd(), 'public');
const hasImg = (src) => fs.existsSync(path.join(publicDir, src.replace(/^\//, '')));
const cards = [
  {
    title: 'The four SL lines',
    setting: 'Show SL Lines',
    img: '/learn/understanding/sl-lines.png',
    alt: 'A chart with the Buy SL line, Sell SL line, Extended Buy SL line and Extended Sell SL line labelled',
    rows: [
      { pct: 'Buy', text: 'Buy SL line: 1.5 bar heights below support — the stop for a B.' },
      { pct: 'Sell', text: 'Sell SL line: 1.5 bar heights above resistance — the stop for an S.' },
      { pct: 'Ext', text: 'Extended Buy and Extended Sell SL lines: the same distance beyond the extended lines — the stops for an EB or an ES.' },
    ],
  },
];
---
<div class="gzone">
  {cards.map((c) => (
    <article class="gzone-card">
      <figure class="gzone-media">
        {hasImg(c.img) ? (
          <img src={c.img} alt={c.alt} loading="lazy" />
        ) : (
          <div class="gzone-ph">
            <span class="gzone-ph-code">{c.title}</span>
            <span class="gzone-ph-note">Chart example coming soon</span>
          </div>
        )}
      </figure>
      <div class="gzone-body">
        <div class="gzone-head">
          <span class="gzone-name">{c.title}</span>
          <span class="gzone-setting">{c.setting}</span>
        </div>
        <ul class="gzone-rows">
          {c.rows.map((r) => (
            <li>
              <span class="gzone-pct">{r.pct}</span>
              <span class="gzone-text">{r.text}</span>
            </li>
          ))}
        </ul>
      </div>
    </article>
  ))}
</div>

<style>
  .gzone { display: flex; flex-direction: column; gap: 12px; margin: 22px 0; }

  .gzone-card {
    display: grid;
    grid-template-columns: minmax(0, 46%) minmax(0, 1fr);
    align-items: stretch;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
  }

  .gzone-media {
    display: flex;
    margin: 0;
    background: var(--surface-2);
    border-right: 1px solid var(--line);
  }
  .gzone-media img { display: block; width: 100%; height: auto; align-self: center; }

  .gzone-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
    padding: 16px 18px;
  }
  .gzone-head { display: flex; flex-direction: column; gap: 3px; }
  .gzone-name { font-size: 1.05rem; font-weight: 700; color: var(--ink); }
  .gzone-setting { color: var(--muted); font-size: 0.85rem; }

  .gzone-rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .gzone-rows li { display: flex; align-items: flex-start; gap: 10px; margin: 0; }
  .gzone-pct {
    flex: none;
    display: inline-block;
    min-width: 52px;
    padding: 3px 9px;
    border-radius: 8px;
    background: #171a24;
    color: #fff;
    font-weight: 700;
    font-size: 0.85rem;
    text-align: center;
    letter-spacing: 0.02em;
  }
  .gzone-text { color: var(--text); font-size: 1rem; line-height: 1.5; }

  /* Placeholder shown until the screenshot is dropped in */
  .gzone-ph {
    flex: 1;
    aspect-ratio: 4 / 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
  }
  .gzone-ph-code { font-weight: 800; font-size: 1.2rem; color: var(--ink); }
  .gzone-ph-note { color: var(--muted); font-size: 0.9rem; }

  @media (max-width: 640px) {
    .gzone-card { grid-template-columns: 1fr; }
    .gzone-media { border-right: none; border-bottom: 1px solid var(--line); }
  }
</style>
