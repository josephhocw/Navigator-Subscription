---
// Collapsed-by-default disclosure for optional, denser reference material
// (e.g. the exact entry/SL/TP numbers behind the line-based method). Keeps the
// main flow light for the 50s-60s audience while preserving the precise rules
// for those who want them. Not an h2, so it stays out of the sub-step numbering.
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<details class="gdetails">
  <summary class="gdetails-summary">
    <span class="gdetails-chev" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
    </span>
    <span>{title}</span>
  </summary>
  <div class="gdetails-body">
    <slot />
  </div>
</details>

<style>
  .gdetails {
    margin: 26px 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }
  .gdetails-summary {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 15px 18px;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    color: var(--ink);
    user-select: none;
  }
  .gdetails-summary::-webkit-details-marker { display: none; }
  .gdetails-summary:hover { color: var(--cyan-light); }
  .gdetails-summary:focus-visible {
    outline: 2px solid var(--cyan-light);
    outline-offset: -2px;
  }
  .gdetails-chev {
    display: inline-flex;
    color: var(--muted);
    transition: transform 0.18s ease;
  }
  .gdetails-chev svg { width: 18px; height: 18px; }
  .gdetails[open] .gdetails-chev { transform: rotate(90deg); }
  .gdetails-body {
    padding: 2px 18px 6px;
    border-top: 1px solid var(--line);
  }
</style>
