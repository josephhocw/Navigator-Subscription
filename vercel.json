{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd web && npm install && npm run build",
  "outputDirectory": "web/dist",
  "crons": [
    { "path": "/api/reminder-send", "schedule": "0 11 22 7 *" },
    { "path": "/api/reminder-send", "schedule": "30 0 25 7 *" },
    { "path": "/api/tradingview-reconcile", "schedule": "0 3 * * *" },
    { "path": "/api/followup-send", "schedule": "0 1 * * *" }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/landingvideo-2.mp4",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/landingvideo-2.webm",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
